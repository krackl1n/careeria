@startuml C4-Dynamic-HRIntegration
!include ../common/styles.puml

title Careeria — обработка webhook от HR-системы
LAYOUT_LEFT_RIGHT()

System_Ext(employerHrSystem, "Employer HR System", "Корпоративная HR-система работодателя.")

System_Boundary(platform, "Careeria") {
    Container(apiGateway, "API Gateway", "Go, grpc-gateway, grpc-go", "REST-to-gRPC маршрутизация и проверка входных запросов.", $tags="gateway")
    Container(integrationService, "Integration Service", "Go, REST, Webhooks, Kafka", "Проверяет подпись и преобразует webhook в событие.", $tags="platform")
    ContainerQueue(kafka, "Kafka", "Apache Kafka, KRaft", "Шина доменных событий.", $tags="eventBus")
    Container(hiringService, "Hiring Service", "Go, gRPC, Protobuf, pgx, sqlc", "Владелец state machine процесса найма.", $tags="business")
    ContainerDb(hiringDb, "Hiring DB", "PostgreSQL", "Отклики и этапы найма.", $tags="storage")
}

Rel(employerHrSystem, apiGateway, "1. Отправляет webhook", "HTTPS / JSON")
Rel(apiGateway, integrationService, "2. Передаёт webhook", "HTTP / gRPC")
Rel(integrationService, kafka, "3. Публикует событие", "Kafka / Avro", $tags="async")
Rel(kafka, hiringService, "4. Доставляет событие", "Kafka / Avro", $tags="async")
Rel(hiringService, hiringDb, "5. Сохраняет изменение", "SQL")

SHOW_LEGEND()
@enduml
