@startuml member1-l2
!include ../../../common/styles.puml
!include ../../../model/elements.puml

title Домен кандидатов и управления вакансиями — контейнерная диаграмма (L2)
LAYOUT_LEFT_RIGHT()

CandidateActor()
RecruiterActor()
IdentityProviderSystem()

System_Boundary(platform, "Careeria — домен кандидатов и управления вакансиями") {
    EntryPoints()
    AuthenticationDependency()
    CandidateDomain(1)
    VacancyDomain(1)
    FilesDomain(1)
    OpenFgaContainer("authorization")
}

Rel(candidate, web, "Использует", "HTTPS")
Rel(recruiter, web, "Использует", "HTTPS")
Rel(web, bff, "Вызывает API", "HTTPS / JSON")
Rel(bff, apiGateway, "Вызывает внутренний API", "HTTPS / gRPC")
Rel(apiGateway, identityService, "Проверяет пользователя", "gRPC")
Rel(identityService, identityProvider, "Аутентифицирует пользователя", "OAuth 2.0 / OIDC")
Rel(apiGateway, candidateService, "Работает с профилями", "gRPC")
Rel(apiGateway, vacancyService, "Работает с вакансиями", "gRPC")
Rel(candidateService, candidateDb, "Хранит профили и метаданные резюме", "SQL")
Rel(candidateService, openFga, "Проверяет доступ", "OpenFGA API")
Rel(vacancyService, openFga, "Проверяет доступ", "OpenFGA API")
Rel(candidateService, fileService, "Загружает и связывает резюме", "gRPC")
Rel(fileService, objectStorage, "Читает и записывает файлы", "S3 API")
Rel(web, objectStorage, "Загружает файл по presigned URL", "HTTPS / S3 API")
Rel(vacancyService, vacancyDb, "Хранит вакансии", "SQL")

ShowArchitectureLegend()
@enduml
