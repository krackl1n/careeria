@startuml candidate-service-l3
!include ../../common/component-styles.puml
!include ../../common/component-wide-layout.puml
!include ../../model/component-elements.puml

System_Boundary(careeria, "Careeria") {
    ComponentApiGateway()

    Container_Boundary(candidate_container, $candidateServiceName) {
        Component(grpc_handler, "gRPC Server", "Go / gRPC", "Команды и запросы CandidateService")

        together {
            Component(profile_svc, "Candidate Profile Service", "Go Application Service", "Профиль, опыт, навыки, предпочтения, статус поиска и видимость")
            Component(resume_svc, "Resume Service", "Go Application Service", "Загрузка, версии, основное резюме, скачивание и удаление")
        }

        Component(authorization_client, "Authorization Client", "Go / OpenFGA SDK", "ReBAC-проверки; бизнес-политики остаются в сервисах и домене")
        Component(candidate_repo, "Candidate Repo", "Go / pgx, sqlc", "Агрегат CandidateProfile и доступные представления")
        Component(outbox, "Transactional Outbox", "Go / pgx, sqlc", "Атомарная запись событий с изменением состояния")
        Component(resume_repo, "Resume Repo", "Go / pgx, sqlc", "Resume, версии файлов и задачи освобождения ссылок")
        Component(file_client, "File Service Client", "Go / gRPC", "Загрузка, проверка готовности, привязка и освобождение файлов")
        Component(cleanup_worker, "Resume Cleanup Worker", "Go Background Worker", "Захват cleanup jobs, повторы освобождения файлов и reconciliation")
    }

    together {
        ComponentOpenFga()
        ComponentCandidateDatabase()
        ComponentFileService()
    }
    ComponentObjectStorage()
}

' Явные lowercase-направления удерживают горизонтальный порядок в Graphviz.
profile_svc -[hidden]right- resume_svc
resume_svc -[hidden]right- cleanup_worker
candidate_repo -[hidden]right- authorization_client
authorization_client -[hidden]right- outbox
outbox -[hidden]right- resume_repo
resume_repo -[hidden]right- file_client
grpc_handler -[hidden]down- cleanup_worker
openFga -[hidden]right- candidateDb
candidateDb -[hidden]right- fileService

Rel_(apiGateway, grpc_handler, "Профиль и резюме", "gRPC", "-down->>")
Rel_(grpc_handler, profile_svc, "Профиль", "In-process", "-down->>")
Rel_(grpc_handler, resume_svc, "Резюме", "In-process", "-down->>")
Rel(profile_svc, authorization_client, "Доступ", "In-process")
Rel(resume_svc, authorization_client, "Доступ", "In-process")
Rel_(profile_svc, candidate_repo, "Читает / сохраняет", "In-process", "-down->>")
Rel_(resume_svc, resume_repo, "Читает / сохраняет", "In-process", "-down->>")
Rel(profile_svc, outbox, "События профиля", "In-process")
Rel(resume_svc, outbox, "События резюме", "In-process")
Rel(resume_svc, file_client, "Проверяет и связывает файл", "In-process")
Rel_(cleanup_worker, resume_repo, "Cleanup jobs", "In-process", "-down->>")
Rel_(cleanup_worker, file_client, "Освобождает файлы", "In-process", "-down->>")

Rel_(authorization_client, openFga, "Проверяет доступ", "OpenFGA API", "-down->>")
Rel_(candidate_repo, candidateDb, "Профили", "SQL / TCP", "-down->>")
Rel_(outbox, candidateDb, "События", "SQL / TCP", "-down->>")
Rel_(resume_repo, candidateDb, "Метаданные и jobs", "SQL / TCP", "-down->>")
Rel_(file_client, fileService, "Операции с файлами", "gRPC", "-down->>")
Rel_(fileService, objectStorage, "Файлы резюме", "S3 API", "-down->>")

SHOW_FLOATING_LEGEND()
@enduml
