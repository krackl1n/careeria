@startuml C4-Dynamic-HRIntegration
!include ../common/styles.puml
!include ../model/elements.puml

title Careeria — обработка webhook от HR-системы
LAYOUT_LEFT_RIGHT()

EmployerHrSystem()

System_Boundary(platform, "Careeria") {
    Container(apiGateway, "API Gateway", "Go, grpc-gateway, grpc-go", "REST-to-gRPC маршрутизация и проверка входных запросов.", $tags="gateway")
    IntegrationServiceContainer("platform")
    IntegrationDatabase("storage")
    DebeziumContainer("eventInfrastructure")
    ContainerQueue(kafka, "Kafka", "Apache Kafka, KRaft", "Шина доменных событий.", $tags="eventBus")
    HiringServiceContainer("business")
    HiringDatabase("storage")
}

Rel(employerHrSystem, apiGateway, "1. Отправляет webhook", "HTTPS / JSON")
Rel(apiGateway, integrationService, "2. Передаёт сырое тело и подпись", "HTTP")
Rel(integrationService, integrationDb, "3. Проверяет и фиксирует inbox + outbox", "SQL transaction")
Rel(integrationDb, debezium, "4. Передаёт outbox", "PostgreSQL WAL", $tags="cdc")
Rel(debezium, kafka, "5. Публикует нормализованное событие", "Kafka / Avro", $tags="async")
Rel(kafka, hiringService, "6. Доставляет событие", "Kafka / Avro", $tags="async")
Rel(hiringService, hiringDb, "7. Проверяет FSM и сохраняет изменение", "SQL transaction")

ShowArchitectureLegend()
@enduml
