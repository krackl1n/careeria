@startuml hiring-application-service
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam shadowing false
skinparam ranksep 45
skinparam nodesep 60
skinparam packagePadding 15

skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #2C3E50
    BorderColor #34495E
}

package "Component: Application Service (Hiring Domain)" {

    ' ===================================================
    ' 1. ПРИКЛАДНОЙ СЛОЙ (ОРКЕСТРАЦИЯ I/O И ЮЗКЕЙСЫ)
    ' ===================================================
    package "Application Layer" {
        class HiringApplicationService <<Application Service>> {
            - appRepo: ApplicationRepository
            - interviewRepo: InterviewRepository
            - outboxRepo: OutboxRepository
            - authPort: AuthorizationPort
            - offerPolicy: OfferEligibilityPolicy
            - txManager: TransactionManager
            - eventFactory: Factory
            - clock: Clock
            - idGen: IDGenerator
            + ApplyVacancy(ctx: Context, input: ApplyVacancyInput): UUID
            + ChangeStage(ctx: Context, input: ChangeStageInput): error
            + GetApplication(ctx: Context, appID: UUID, actorID: UUID): JobApplication
            + GetPipelineHistory(ctx: Context, appID: UUID, actorID: UUID): PipelineHistoryOutput
            + HandleAssessmentResult(ctx: Context, input: AssessmentCompletedInput): error
            + PromoteToInterview(ctx: Context, appID: UUID, actorID: UUID, reason: string): error
            + RejectApplication(ctx: Context, input: RejectInput): error
            + WithdrawApplication(ctx: Context, input: WithdrawInput): error
        }

    }

    ' ===================================================
    ' 2. ДОМЕННЫЙ СЛОЙ (ЧИСТАЯ ЛОГИКА БЕЗ I/O)
    ' ===================================================
    package "Domain Layer" {

        class JobApplication <<Aggregate Root>> {
            + ID: UUID
            + VacancyID: UUID
            + CandidateID: UUID
            + CurrentStage: PipelineStage
            + Version: int
            + History: List<StageTransition>
            + CreatedAt: Timestamp
            + UpdatedAt: Timestamp
            + ChangeStage(targetStage: PipelineStage, actorID: UUID, reason: string, now: Timestamp): error
            + MarkInterview(actorID: UUID, comment: string, now: Timestamp): error
            + MarkOfferPending(actorID: UUID, now: Timestamp): error
            + AdvanceFromAssessment(score: int, actorID: UUID, now: Timestamp): error
            + Reject(reason: RejectReason, actorID: UUID, now: Timestamp): error
            + Withdraw(actorID: UUID, reason: string, now: Timestamp): error
            - addTransition(to: PipelineStage, by: UUID, reason: string, now: Timestamp): void
        }

        class StageTransition <<Entity>> {
            + ID: UUID
            + FromStage: PipelineStage
            + ToStage: PipelineStage
            + ChangedBy: UUID
            + ChangedAt: Timestamp
            + Reason: string
            + IsInitial(): bool
            + IsTerminal(): bool
        }

        class OfferEligibilityPolicy <<Domain Policy>> {
            + CanInitiateOffer(app: JobApplication, interviews: List<Interview>): error
        }

        enum PipelineStage <<enumeration>> {
            APPLIED
            SCREENING
            TECH_ASSESSMENT
            INTERVIEW
            OFFER_PENDING
            OFFER_ACCEPTED
            HIRED
            REJECTED
            WITHDRAWN
        }

        enum RejectCode <<enumeration>> {
            NOT_QUALIFIED
            ASSESSMENT_FAILED
            CULTURE_MISMATCH
            CANDIDATE_WITHDREW
            VACANCY_CLOSED
            OVERQUALIFIED
            OTHER
        }

        class RejectReason <<Value Object>> {
            + Code: RejectCode
            + Comment: string
            + EffectiveComment(): string
        }

        class Interview <<Aggregate Root>> {
            + ID: UUID
            + ApplicationID: UUID
            + InterviewType: InterviewType
            + Format: MeetingFormat
            + Status: InterviewStatus
            + ScheduledStartTime: Timestamp
            + ScheduledEndTime: Timestamp
            + MeetingRoomURL: string
            + Participants: List<Participant>
            + Feedbacks: List<Feedback>
            + Version: int
            + CreatedAt: Timestamp
            + UpdatedAt: Timestamp
        }

    }

    ' ===================================================
    ' 3. ВНЕШНИЕ КОНТРАКТЫ (ПОРТЫ И РЕПОЗИТОРИИ)
    ' ===================================================
    package "External Contracts (Ports & Repositories)" {
        interface ApplicationRepository <<interface>> {
            + Create(ctx: Context, app: JobApplication): error
            + Update(ctx: Context, app: JobApplication): error
            + GetByID(ctx: Context, id: UUID): JobApplication
            + GetActiveByCandidateAndVacancy(ctx: Context, candidateID: UUID, vacancyID: UUID): JobApplication
        }
        interface AuthorizationPort <<interface>> {
            + CanApplyVacancy(ctx: Context, actorID: UUID, vacancyID: UUID): error
            + CanManageApplication(ctx: Context, actorID: UUID, appID: UUID): error
        }
        interface InterviewRepository <<interface>> {
            + ListByApplicationID(ctx: Context, appID: UUID): List<Interview>
        }
        interface OutboxRepository <<interface>> {
            + Save(ctx: Context, message: Message): error
        }
    }
}

' ========================================================
' РАСПОЛОЖЕНИЕ И ВЫРАВНИВАНИЕ
' ========================================================

HiringApplicationService -[hidden]down-> JobApplication

JobApplication -[hidden]right-> OfferEligibilityPolicy
OfferEligibilityPolicy -[hidden]right-> Interview
JobApplication -[hidden]down-> StageTransition
StageTransition -[hidden]down-> RejectReason
RejectReason -[hidden]down-> RejectCode
StageTransition -[hidden]right-> PipelineStage

HiringApplicationService -[hidden]right-> ApplicationRepository
ApplicationRepository -[hidden]down-> AuthorizationPort
AuthorizationPort -[hidden]down-> InterviewRepository
InterviewRepository -[hidden]down-> OutboxRepository

Interview -[hidden]right-> ApplicationRepository

' ========================================================
' СВЯЗИ
' ========================================================

HiringApplicationService ..> JobApplication : commands mutation
HiringApplicationService -right-> ApplicationRepository : uses
HiringApplicationService --> AuthorizationPort : uses
HiringApplicationService --> InterviewRepository : uses
HiringApplicationService --> OutboxRepository : uses
JobApplication *-- "*" StageTransition : owns
JobApplication ..> RejectReason : uses
InterviewRepository ..> Interview : provides
JobApplication *-- "1" PipelineStage
RejectReason *-- "1" RejectCode
HiringApplicationService --> OfferEligibilityPolicy : executes policy
OfferEligibilityPolicy ..> JobApplication : evaluates
OfferEligibilityPolicy ..> Interview : evaluates

@enduml
