!unquoted procedure IdentityAccess($withDatabase, $withProjection, $withOpenFga)
    Container_Boundary(identityBoundary, "Идентификация и доступ") {
        Container(identityService, "Identity Service", "Go, gRPC, OAuth 2.0/OIDC, JWT, Argon2id", "Регистрация, credentials, access/refresh tokens, ротация сессий и интеграция с Keycloak.", $tags="platform")
        !if ($withDatabase == 1)
            ContainerDb(identityDb, "Identity DB", "PostgreSQL", "Пользователи, credentials, refresh sessions и transactional outbox.", $tags="storage")
        !endif
        !if ($withProjection == 1)
            Container(authzProjection, "AuthZ Synchronization Service", "Go, Kafka consumer, OpenFGA SDK", "Преобразует доменные события в tuples ролей и отношений доступа OpenFGA.", $tags="platform")
        !endif
        !if ($withOpenFga == 1)
            Container(openFga, "OpenFGA", "OpenFGA, PostgreSQL", "ReBAC-модель и tuples для проверок доступа к компаниям, вакансиям, откликам и интервью.", $tags="authorization")
        !endif
    }
!endprocedure

