!unquoted procedure IdentityAccess($withDatabase, $withProjection, $withOpenFga)
    Container_Boundary(identityBoundary, "Идентификация и доступ") {
        Container(identityService, "Identity Service", "Service", "Регистрация, OAuth/OIDC, токены и пользовательские сессии.", $tags="platform")
        !if ($withDatabase == 1)
            ContainerDb(identityDb, "Identity DB", "PostgreSQL", "Учётные данные и transactional outbox.", $tags="storage")
        !endif
        !if ($withProjection == 1)
            Container(authzProjection, "AuthZ Synchronization Service", "Kafka consumer", "Синхронизирует роли и отношения доступа.", $tags="platform")
        !endif
        !if ($withOpenFga == 1)
            Container(openFga, "OpenFGA", "OpenFGA", "Источник истины для ролевой и relationship-based авторизации.", $tags="authorization")
        !endif
    }
!endprocedure

