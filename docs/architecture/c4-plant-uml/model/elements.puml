        !if ($withPublisher == 1)
            Container(realtimePublisher, "Realtime Publisher", "Kafka consumer", "Преобразует события для доставки в реальном времени.", $tags="platform")
        !endif
        !if ($withCentrifugo == 1)
            Container(centrifugo, "Centrifugo", "WebSocket", "Доставляет события пользователям в реальном времени.", $tags="realtime")
        !endif
        !if ($withLivekit == 1)
            Container(livekit, "LiveKit", "WebRTC", "Аудио, видео и демонстрация экрана.", $tags="media")
        !endif
    }
!endprocedure

!unquoted procedure EventPlatform()
    Container_Boundary(eventBoundary, "Событийная платформа") {
        ContainerQueue(kafka, "Kafka", "Apache Kafka", "Шина событий для асинхронного взаимодействия.", $tags="eventBus")
        Container(schemaRegistry, "Schema Registry", "Avro", "Версионирование и проверка совместимости схем.", $tags="eventInfrastructure")
        Container(debezium, "Debezium", "Debezium", "Публикует события из transactional outbox.", $tags="eventInfrastructure")
    }
!endprocedure

!unquoted procedure OutboxDatabases()
    Container_Boundary(outboxBoundary, "Transactional outbox источники") {
        ContainerDb(candidateDb, "Candidate DB", "PostgreSQL", "Candidate outbox.", $tags="storage")
        ContainerDb(companyDb, "Company DB", "PostgreSQL", "Company outbox.", $tags="storage")
        ContainerDb(vacancyDb, "Vacancy DB", "PostgreSQL", "Vacancy outbox.", $tags="storage")
        ContainerDb(hiringDb, "Hiring DB", "PostgreSQL", "Hiring outbox.", $tags="storage")
        ContainerDb(assessmentDb, "Assessment DB", "PostgreSQL", "Assessment outbox.", $tags="storage")
        ContainerDb(communicationDb, "Communication DB", "PostgreSQL", "Communication outbox.", $tags="storage")
        ContainerDb(identityDb, "Identity DB", "PostgreSQL", "Identity outbox.", $tags="storage")
    }
!endprocedure
