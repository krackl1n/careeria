@startuml member3-l1
!include ../../common/styles.puml

title Домен оценки, коммуникаций, realtime-взаимодействия и медиа — системный контекст (L1)
LAYOUT_LEFT_RIGHT()

Person(candidate, "Кандидат", "Проходит оценивание, общается и участвует в интервью.")
