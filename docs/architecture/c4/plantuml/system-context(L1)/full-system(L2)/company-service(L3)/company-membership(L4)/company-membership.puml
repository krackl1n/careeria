@startuml company-membership
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ranksep 40
skinparam nodesep 35
skinparam packagePadding 15
hide empty members
title Company Service - членство и приглашения (L4)

package "Прикладной слой" {
    class MembershipService <<Application Service>> {
        + Invite(input: InviteMember): UUID
        + Accept(input: AcceptInvitation): error
        + ChangeRole(input: ChangeMemberRole): error
        + Suspend(input: SuspendMember): error
    }
}
package "Доменная модель" {
    class Member <<Aggregate Root>> {
        - id: UUID
        - companyID: UUID
        - identityID: UUID
        - role: MemberRole
        - status: MemberStatus
        - version: Int64
        + ChangeRole(role: MemberRole): error
        + Suspend(): error
        + Activate(): error
    }
    class Invitation <<Aggregate Root>> {
        - id: UUID
        - companyID: UUID
        - inviteeIdentityID: UUID
        - proposedRole: MemberRole
        - expiresAt: Timestamp
        - status: InvitationStatus
        + Accept(identityID: UUID, now: Timestamp): error
        + Revoke(): error
    }
}
package "Выходные интерфейсы" {
    interface MemberRepository <<Port>> {
        + Get(companyID: UUID, identityID: UUID): Member
        + CountActiveOwners(companyID: UUID): Int
        + Save(member: Member, expectedVersion: Int64): error
    }
    interface InvitationRepository <<Port>> {
        + Get(id: UUID): Invitation
        + FindPending(companyID: UUID, identityID: UUID): Invitation
        + Save(invitation: Invitation): error
    }
    interface CompanyRepository <<Port>> {
        + GetForUpdate(id: UUID): Company
    }
    interface AuthorizationPort <<Port>> {
        + Check(actorID: UUID, resourceID: UUID, action: String): error
    }
    interface TransactionManager <<Port>> {
        + Do(operation: Transaction): error
    }
    interface OutboxWriter <<Port>> {
        + Append(event: DomainEvent): error
    }
}
MembershipService ..> Member : изменяет членство
MembershipService ..> Invitation : ведёт приглашение
MembershipService ..> MemberRepository : использует
MembershipService ..> InvitationRepository : использует
MembershipService ..> CompanyRepository : использует
MembershipService ..> AuthorizationPort : использует
MembershipService ..> TransactionManager : использует
MembershipService ..> OutboxWriter : использует

Member -[hidden]right- Invitation
MemberRepository -[hidden]right- InvitationRepository
CompanyRepository -[hidden]right- AuthorizationPort
TransactionManager -[hidden]right- OutboxWriter
MemberRepository -[hidden]down- CompanyRepository
CompanyRepository -[hidden]down- TransactionManager
@enduml
