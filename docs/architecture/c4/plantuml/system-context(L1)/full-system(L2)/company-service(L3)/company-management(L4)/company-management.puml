@startuml company-management
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ranksep 40
skinparam nodesep 35
skinparam packagePadding 15
hide empty members
title Company Service - управление компанией и верификацией (L4)

package "Прикладной слой" {
    class CompanyApplicationService <<Application Service>> {
        + Create(input: CreateCompany): UUID
        + Update(input: UpdateCompany): error
        + SubmitForVerification(input: SubmitVerification): UUID
        + DecideVerification(input: VerificationDecision): error
        + Block(input: BlockCompany): error
    }
}
package "Доменная модель" {
    class Company <<Aggregate Root>> {
        - id: UUID
        - name: String
        - lifecycle: CompanyLifecycle
        - version: Int64
        + UpdateProfile(input: CompanyProfile): error
        + Block(reason: String): error
    }
    class VerificationRequest <<Aggregate Root>> {
        - id: UUID
        - companyID: UUID
        - ordinal: Int64
        - status: VerificationStatus
        - submittedLegalName: String
        + Approve(actorID: UUID): error
        + Reject(actorID: UUID, reason: String): error
    }
}
package "Выходные интерфейсы" {
    interface CompanyRepository <<Port>> {
        + Get(id: UUID): Company
        + Save(company: Company, expectedVersion: Int64): error
    }
    interface VerificationRequestRepository <<Port>> {
        + Latest(companyID: UUID): VerificationRequest
        + Save(request: VerificationRequest): error
    }
    interface AuthorizationPort <<Port>> {
        + Check(actorID: UUID, resourceID: UUID, action: String): error
    }
    interface TransactionManager <<Port>> {
        + Do(operation: Transaction): error
    }
    interface OutboxWriter <<Port>> {
        + Append(event: DomainEvent): error
    }
}
CompanyApplicationService ..> Company : изменяет
CompanyApplicationService ..> VerificationRequest : ведёт заявку
CompanyApplicationService ..> CompanyRepository : использует
CompanyApplicationService ..> VerificationRequestRepository : использует
CompanyApplicationService ..> AuthorizationPort : использует
CompanyApplicationService ..> TransactionManager : использует
CompanyApplicationService ..> OutboxWriter : использует

Company -[hidden]right- VerificationRequest
CompanyRepository -[hidden]right- VerificationRequestRepository
AuthorizationPort -[hidden]right- TransactionManager
CompanyRepository -[hidden]down- AuthorizationPort
AuthorizationPort -[hidden]down- OutboxWriter
@enduml
