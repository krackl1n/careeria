@startuml integration-inbound-webhook
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ranksep 40
skinparam nodesep 35
skinparam packagePadding 15
hide empty members
title Integration Service - проверка и приём вебхуков (L4)

package "Прикладной слой" {
    class InboundWebhookService <<Application Service>> {
        + Accept(route: String, body: Bytes, headers: Map): ReceiptResult
    }
}
package "Доменная модель" {
    class IntegrationConnection <<Aggregate Root>> {
        - id: UUID
        - companyID: UUID
        - provider: String
        - status: ConnectionStatus
        - allowedEventTypes: List<String>
        + ValidateInbound(eventType: String): error
    }
    class InboundReceipt <<Aggregate Root>> {
        - id: UUID
        - connectionID: UUID
        - providerMessageID: String
        - bodyDigest: String
        - normalizedEventID: UUID
        - mappingVersion: Int
        + Matches(digest: String): Bool
    }
    class SigningKey <<Entity>> {
        - id: UUID
        - connectionID: UUID
        - status: KeyStatus
        - notBefore: Timestamp
        - expiresAt: Timestamp
        + ValidateAt(now: Timestamp): error
    }
}
package "Выходные интерфейсы" {
    interface IntegrationRepository <<Port>> {
        + GetConnection(route: String): IntegrationConnection
        + FindReceipt(connectionID: UUID, messageID: String): InboundReceipt
        + SaveReceipt(receipt: InboundReceipt): error
    }
    interface InboundWebhookAdapter <<Port>> {
        + Verify(body: Bytes, headers: Map, key: SigningKey): error
        + Normalize(body: Bytes, mappingVersion: Int): DomainEvent
    }
    interface TransactionManager <<Port>> {
        + Do(operation: Transaction): error
    }
    interface OutboxWriter <<Port>> {
        + Append(event: DomainEvent): error
    }
}
InboundWebhookService ..> IntegrationConnection : проверяет источник
InboundWebhookService ..> InboundReceipt : фиксирует приём
IntegrationConnection --> SigningKey : ключи
InboundWebhookAdapter ..> SigningKey : проверяет подпись
InboundWebhookService ..> IntegrationRepository : использует
InboundWebhookService ..> InboundWebhookAdapter : использует
InboundWebhookService ..> TransactionManager : использует
InboundWebhookService ..> OutboxWriter : использует

IntegrationConnection -[hidden]right- InboundReceipt
IntegrationConnection -[hidden]down- SigningKey
IntegrationRepository -[hidden]right- InboundWebhookAdapter
TransactionManager -[hidden]right- OutboxWriter
IntegrationRepository -[hidden]down- TransactionManager
@enduml
