@startuml member2-dynamic
!include ../common/styles.puml
!include ../model/elements.puml

title Careeria — Сквозной процесс фиксации результатов собеседования, перехода FSM в оффер и публикации событий найма
LAYOUT_LEFT_RIGHT()

Person(hiringManager, "Нанимающий менеджер", "Проводит собеседование и отправляет оценку компетенций.")
Person(candidate, "Кандидат", "Проходит собеседование и получает уведомление о переходе на этап оффера.")

System_Boundary(platform, "Платформа Careeria") {
    Container(web, "Web Application", "Next.js, React", "Пользовательский интерфейс.", $tags="frontend")
    Container(bff, "BFF", "Go, net/http, grpc-go", "Сессионный слой и агрегация API.", $tags="edge")
    Container(apiGateway, "API Gateway", "Go, grpc-gateway", "Маршрутизация и доверенный identity context.", $tags="gateway")
    HiringServiceContainer("business")
    OpenFgaContainer("platform")
    HiringDatabase("storage")
    DebeziumContainer("eventInfrastructure")
    ContainerQueue(kafka, "Kafka", "Apache Kafka, KRaft", "Шина доменных событий.", $tags="eventBus")
    Container(notificationService, "Notification Service", "Go, Kafka Consumer", "Оркестрация мультиканальных оповещений.", $tags="business")
}

EmployerHrSystem()
NotificationProvidersSystem()

Rel(hiringManager, web, "1. Отправляет оценку и комментарий (SubmitFeedback)", "HTTPS / TLS 1.3")
Rel(web, bff, "2. Передаёт запрос с сессионной кукой", "HTTPS / JSON")
Rel(bff, apiGateway, "3. Направляет авторизованный RPC-запрос", "gRPC / HTTP2")
Rel(apiGateway, hiringService, "4. Вызывает метод SubmitFeedback()", "gRPC / HTTP2, порт 50053")
Rel(hiringService, openFga, "5. Проверяет права оценщика (CanEvaluate)", "gRPC / mTLS, порт 8081")
Rel(hiringService, hiringDb, "6. Сохраняет Feedback, меняет FSM на OFFER_PENDING и пишет Outbox", "SQL Transaction, порт 5432")
Rel(hiringDb, debezium, "7. Считывает журнал транзакций WAL (CDC)", "PostgreSQL WAL (pgoutput)")
Rel(debezium, kafka, "8. Публикует событие CandidateEvaluatedEvent", "Kafka / Avro, порт 9092", $tags="async")
Rel(kafka, notificationService, "9. Доставляет событие изменения этапа", "Kafka / Avro", $tags="async")
Rel(notificationService, notificationProviders, "10. Инициирует отправку уведомления кандидату", "HTTPS / REST API")
Rel(kafka, employerHrSystem, "11. Синхронизирует этап кандидата во внешней HR-системе", "HTTPS / Webhook", $tags="async")

ShowArchitectureLegend()
@enduml

