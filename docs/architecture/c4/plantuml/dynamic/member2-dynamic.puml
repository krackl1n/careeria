@startuml member2-dynamic
!include ../common/styles.puml
!include ../model/elements.puml

title Careeria — Сквозной процесс фиксации результатов собеседования, перехода FSM в оффер и публикации событий найма
LAYOUT_LEFT_RIGHT()

Person(hiringManager, "Нанимающий менеджер", "Проводит собеседование, выставляет оценку и получает подтверждение в UI.")
Person(candidate, "Кандидат", "Проходит собеседование и получает уведомление о переходе на этап оффера.")

System_Boundary(platform, "Платформа Careeria") {
    Container(web, "Web Application", "Next.js, React", "Пользовательский интерфейс.", $tags="frontend")
    Container(bff, "BFF", "Go, net/http, grpc-go", "Сессионный слой и агрегация API.", $tags="edge")
    Container(apiGateway, "API Gateway", "Go, grpc-gateway", "Маршрутизация и доверенный identity context.", $tags="gateway")
    HiringServiceContainer("business")
    OpenFgaContainer("platform")
    HiringDatabase("storage")
    DebeziumContainer("eventInfrastructure")
    ContainerQueue(kafka, "Kafka", "Apache Kafka, KRaft", "Шина доменных событий.", $tags="eventBus")
    Container(notificationService, "Notification Service", "Go, Kafka Consumer", "Оркестрация мультиканальных оповещений.", $tags="business")
    Container(integrationService, "Integration Service", "Go, Kafka Consumer", "Синхронизация кадровых данных и отправка вебхуков.", $tags="business")
}

EmployerHrSystem()
NotificationProvidersSystem()

' --- Синхронная цепочка: Запрос ---
Rel(hiringManager, web, "1. Отправляет форму оценки (SubmitFeedback)", "HTTPS / UI")
Rel(web, bff, "2. Передаёт запрос с сессионной кукой", "HTTPS / JSON")
Rel(bff, apiGateway, "3. Направляет авторизованный RPC-запрос", "gRPC / HTTP2")
Rel(apiGateway, hiringService, "4. Вызывает метод SubmitFeedback()", "gRPC / HTTP2, порт 50053")
Rel(hiringService, openFga, "5. Проверяет права оценщика (can_evaluate)", "gRPC / mTLS, порт 8081")
Rel(hiringService, hiringDb, "6. Сохраняет Feedback, меняет FSM на OFFER_PENDING и пишет Outbox", "SQL Transaction, порт 5432")

' --- Синхронная цепочка: Ответ клиенту ---
Rel(hiringService, apiGateway, "7. Возвращает статус OK и DTO отклика", "gRPC response")
Rel(apiGateway, bff, "8. Транслирует ответ шлюза", "gRPC response")
Rel(bff, web, "9. Возвращает 200 OK (статус OFFER_PENDING)", "JSON / HTTPS")
Rel(web, hiringManager, "10. Отображает в UI подтверждение успешного перевода", "UI Render")

' --- Асинхронная цепочка: CDC, события и интеграции ---
Rel(hiringDb, debezium, "11. Считывает запись Outbox из журнала транзакций WAL (CDC)", "PostgreSQL WAL (pgoutput)")
Rel(debezium, kafka, "12. Публикует CandidateEvaluatedEvent в топик hiring.events", "Kafka / Avro, порт 9092", $tags="async")
Rel(kafka, notificationService, "13. Доставляет событие изменения этапа найма", "Kafka / Avro", $tags="async")
Rel(notificationService, notificationProviders, "14. Инициирует отправку уведомления кандидату", "HTTPS / REST API")
Rel(kafka, integrationService, "15. Вычитывает событие смены этапа", "Kafka Protocol / TCP", $tags="async")
Rel(integrationService, employerHrSystem, "16. Синхронизирует этап кандидата (Webhook)", "HTTPS / Webhooks", $tags="async")

ShowArchitectureLegend()
@enduml
