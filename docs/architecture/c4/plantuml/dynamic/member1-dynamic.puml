@startuml member1-dynamic
!include ../common/styles.puml
!include ../model/elements.puml

title Careeria — Сквозной процесс загрузки резюме кандидата, привязки к профилю и публикации доменных событий
LAYOUT_LEFT_RIGHT()

Person(candidate, "Кандидат", "Заполняет профиль и загружает резюме через интерфейс платформы.")

System_Boundary(platform, "Платформа Careeria") {
    Container(web, "Web Application", "Next.js, React", "Пользовательский интерфейс.", $tags="frontend")
    Container(bff, "BFF", "Go, net/http, grpc-go", "Сессионный слой и агрегация API.", $tags="edge")
    Container(apiGateway, "API Gateway", "Go, grpc-gateway", "Маршрутизация и доверенный identity context.", $tags="gateway")
    CandidateServiceContainer("business")
    OpenFgaContainer("platform")
    FileServiceContainer("platform")
    ObjectStorageContainer("storage")
    CandidateDatabase("storage")
    DebeziumContainer("eventInfrastructure")
    ContainerQueue(kafka, "Kafka", "Apache Kafka, KRaft", "Шина доменных событий.", $tags="eventBus")
    VacancyServiceContainer("business")
}

NotificationProvidersSystem()

' --- Синхронная цепочка: запрос и генерация presigned URL ---
Rel(candidate, web, "1. Заполняет форму профиля и инициирует загрузку резюме", "HTTPS / UI")
Rel(web, bff, "2. Передаёт запрос с сессионной кукой", "HTTPS / JSON")
Rel(bff, apiGateway, "3. Направляет авторизованный RPC-запрос", "gRPC / HTTP2")
Rel(apiGateway, candidateService, "4. Вызывает метод RequestResumeUpload()", "gRPC / HTTP2, порт 50052")
Rel(candidateService, openFga, "5. Проверяет права кандидата (can_upload_resume)", "gRPC / mTLS, порт 8081")
Rel(candidateService, fileService, "6. Запрашивает presigned URL для загрузки файла", "gRPC / HTTP2, порт 50055")
Rel(fileService, objectStorage, "7. Генерирует временный presigned PUT URL (TTL 15 мин, AWS Sig V4)", "S3 API / HTTPS, порт 9000")

' --- Синхронная цепочка: ответ с presigned URL ---
Rel(fileService, candidateService, "8. Возвращает presigned URL и fileId", "gRPC response")
Rel(candidateService, apiGateway, "9. Передаёт presigned URL клиенту", "gRPC response")
Rel(apiGateway, bff, "10. Транслирует ответ шлюза", "gRPC response")
Rel(bff, web, "11. Возвращает 200 OK с presigned URL и fileId", "JSON / HTTPS")

' --- Прямая загрузка файла ---
Rel(web, objectStorage, "12. Загружает файл резюме напрямую по presigned URL", "HTTPS / PUT, S3 API, порт 9000", $tags="async")

' --- Синхронная цепочка: подтверждение загрузки ---
Rel(web, bff, "13. Подтверждает успешную загрузку (ConfirmResumeUpload + fileId)", "HTTPS / JSON")
Rel(bff, apiGateway, "14. Направляет подтверждение", "gRPC / HTTP2")
Rel(apiGateway, candidateService, "15. Вызывает ConfirmResumeUpload(fileId)", "gRPC / HTTP2, порт 50052")
Rel(candidateService, candidateDb, "16. Сохраняет метаданные резюме, обновляет профиль и пишет Outbox", "SQL Transaction, порт 5432")

' --- Синхронная цепочка: ответ клиенту ---
Rel(candidateService, apiGateway, "17. Возвращает статус OK и DTO профиля", "gRPC response")
Rel(apiGateway, bff, "18. Транслирует ответ шлюза", "gRPC response")
Rel(bff, web, "19. Возвращает 200 OK (резюме загружено)", "JSON / HTTPS")
Rel(web, candidate, "20. Отображает в UI подтверждение и превью резюме", "UI Render")

' --- Асинхронная цепочка: CDC, события и интеграции ---
Rel(candidateDb, debezium, "21. Считывает запись Outbox из журнала транзакций WAL (CDC)", "PostgreSQL WAL (pgoutput)", $tags="async")
Rel(debezium, kafka, "22. Публикует CandidateResumeUploadedEvent в топик candidate.events", "Kafka / Avro, порт 9092", $tags="async")
Rel(kafka, vacancyService, "23. Доставляет событие для поиска релевантных вакансий кандидату", "Kafka / Avro", $tags="async")
Rel(kafka, notificationProviders, "24. Notification Service инициирует подтверждение публикации резюме", "HTTPS / REST API", $tags="async")

ShowArchitectureLegend()
@enduml

