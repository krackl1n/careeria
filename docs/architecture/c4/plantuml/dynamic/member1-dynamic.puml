@startuml member1-dynamic
!include ../common/styles.puml
!include ../model/elements.puml

title Careeria — Сквозной процесс публикации вакансии (PublishVacancy)
LAYOUT_LEFT_RIGHT()

Person(recruiter, "Рекрутер", "Редактирует черновик, инициирует публикацию вакансии и получает подтверждение в UI.")

System_Boundary(platform, "Платформа Careeria") {
    Container(web, "Web Application", "Next.js, React", "Пользовательский интерфейс.", $tags="frontend")
    Container(bff, "BFF", "Go, net/http, grpc-go", "Сессионный слой и агрегация API.", $tags="edge")
    Container(apiGateway, "API Gateway", "Go, grpc-gateway", "Маршрутизация и доверенный identity context.", $tags="gateway")
    VacancyServiceContainer("business")
    OpenFgaContainer("platform")
    VacancyDatabase("storage")
    DebeziumContainer("eventInfrastructure")
    ContainerQueue(kafka, "Kafka", "Apache Kafka, KRaft", "Шина доменных событий.", $tags="eventBus")
    Container(authzProjection, "AuthZ Synchronization Service", "Go, Kafka Consumer, OpenFGA SDK", "Обновляет ReBAC-отношения доступа в OpenFGA.", $tags="platform")
    Container(notificationService, "Notification Service", "Go, Kafka Consumer", "Оркестрация мультиканальных оповещений.", $tags="business")
}

NotificationProvidersSystem()

' --- Синхронная цепочка: Запрос ---
Rel(recruiter, web, "1. Инициирует публикацию вакансии (PublishVacancy)", "HTTPS / UI")
Rel(web, bff, "2. Передаёт запрос с сессионной кукой", "HTTPS / JSON")
Rel(bff, apiGateway, "3. Направляет авторизованный RPC-запрос", "gRPC / HTTP2, порт 50051")
Rel(apiGateway, vacancyService, "4. Вызывает метод PublishVacancy()", "gRPC / HTTP2, порт 50054")
Rel(vacancyService, openFga, "5. Проверяет права публикатора (can_publish)", "gRPC / mTLS, порт 8081")
Rel(vacancyService, vacancyDb, "6. Фиксирует статус PUBLISHED (после PublishingPolicy) и пишет Outbox", "SQL Transaction, порт 5432")

' --- Синхронная цепочка: Ответ клиенту ---
Rel(vacancyService, apiGateway, "7. Возвращает статус OK и DTO вакансии", "gRPC response")
Rel(apiGateway, bff, "8. Транслирует ответ шлюза", "gRPC response")
Rel(bff, web, "9. Возвращает 200 OK (статус PUBLISHED)", "JSON / HTTPS")
Rel(web, recruiter, "10. Отображает в UI статус опубликованной вакансии", "UI Render")

' --- Асинхронная цепочка: CDC, события и подписчики ---
Rel(vacancyDb, debezium, "11. Считывает запись Outbox из журнала транзакций WAL (CDC)", "PostgreSQL WAL (pgoutput)", $tags="cdc")
Rel(debezium, kafka, "12. Публикует VacancyPublished в топик careeria.vacancies.events.v1", "Kafka / Avro, порт 9092", $tags="async")
Rel(kafka, authzProjection, "13. Доставляет событие публикации вакансии", "Kafka / Avro", $tags="async")
Rel(authzProjection, openFga, "14. Записывает ReBAC-правила публичного доступа к вакансии", "OpenFGA API / gRPC, порт 8081")
Rel(kafka, notificationService, "15. Вычитывает событие публикации вакансии", "Kafka Protocol / TCP", $tags="async")
Rel(notificationService, notificationProviders, "16. Инициирует рассылку уведомлений релевантным кандидатам", "HTTPS / REST API")

ShowArchitectureLegend()
@enduml
