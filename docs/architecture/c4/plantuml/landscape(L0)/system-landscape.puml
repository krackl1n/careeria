@startuml Careeria-SystemLandscape-L0
!include ../common/styles.puml
!include ../model/elements.puml

title Careeria — Диаграмма системного ландшафта (L0): платформа подбора и корпоративные системы
LAYOUT_LANDSCAPE()

CandidateActor()
RecruiterActor()
HiringManagerActor()
CompanyAdminActor()

Enterprise_Boundary(careeriaScope, "Продуктовая экосистема Careeria") {
    System(platform, "Careeria", "Профили кандидатов и компаний, вакансии, отклики, оценивание, собеседования, офферы и коммуникации.", $link="/architecture/c4/plantuml/system-context(L1)/")
}

Enterprise_Boundary(employerScope, "Корпоративный ИТ-ландшафт работодателя") {
    EmployerHrSystem()
}

IdentityProviderSystem()
NotificationProvidersSystem()

Rel(candidate, platform, "Размещает резюме, ищет вакансии и проходит отбор", "HTTPS")
Rel(recruiter, platform, "Публикует вакансии, ведёт отклики, интервью и офферы", "HTTPS")
Rel(hiringManager, platform, "Оценивает кандидатов и согласует найм", "HTTPS")
Rel(companyAdmin, platform, "Управляет профилем компании, участниками и ролями", "HTTPS")
Rel(recruiter, employerHrSystem, "Работает с кадровыми заявками и результатами найма", "HTTPS")

Rel_R(platform, employerHrSystem, "Передаёт результаты найма и исходящие webhooks", "HTTPS / REST / Webhooks")
Rel_L(employerHrSystem, platform, "Передаёт изменения кадровых данных", "HTTPS / Webhooks")
Rel(platform, identityProvider, "Аутентифицирует пользователей через федеративный вход", "HTTPS / OAuth 2.0 / OIDC")
Rel(platform, notificationProviders, "Запрашивает доставку уведомлений", "HTTPS / API")
Rel_Back(candidate, notificationProviders, "Доставляет приглашения, сообщения и офферы", "Email / Push / SMS")
Rel_Back(recruiter, notificationProviders, "Доставляет уведомления об откликах и интервью", "Email / Push / SMS")

ShowArchitectureLegend()
@enduml
