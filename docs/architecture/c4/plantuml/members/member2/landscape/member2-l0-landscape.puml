@startuml member2-l0
!include ../../../common/styles.puml

title Careeria — Системный ландшафт домена найма и управления персоналом (Level 0)
LAYOUT_LEFT_RIGHT()

Person(candidate, "Кандидат (Соискатель)", "Ищет вакансии, подаёт резюме, отслеживает статусы откликов, проходит онлайн-собеседования и принимает офферы.")
Person(recruiter, "Рекрутер (HR-специалист)", "Формирует воронку подбора, управляет этапами найма, координирует слоты собеседований и выставляет офферы.")
Person(hiringManager, "Нанимающий руководитель", "Согласует требования к вакансии, проводит профильные интервью, выставляет оценки компетенций и согласует офферы.")
Person(companyAdmin, "Администратор компании", "Управляет профилем организации, филиальной структурой, корпоративными правами сотрудников и тарифным планом.")

Enterprise_Boundary(enterprise, "Корпоративная среда работодателя / HR-экосистема") {
    System(careeriaHiring, "Careeria: Подсистема найма (Hiring Domain)", "Сквозное управление воронкой отбора кандидатов (FSM), организация собеседований, скоринг, подготовка и согласование предложений о работе (Job Offers).")
    System(livekitMedia, "Медиа-сервер видеосвязи (LiveKit / WebRTC)", "Внутренний кластерный сервер видеоконференций для проведения онлайн-собеседований с аудио, видео и демонстрацией экрана.")
    
    System(hrSystem, "Корпоративная HR-система / HCM (1С:ЗУП / Workday)", "Учёт организационной структуры, штатного расписания, профилей сотрудников и официальных статусов приёма на работу.")
    System(iamSystem, "Корпоративная служба IAM (Keycloak / OpenFGA)", "Единая точка входа (SSO), федеративная аутентификация сотрудников и вычисление гранулярных прав ReBAC.")
    System(kedoSystem, "Корпоративная система кадрового ЭДО (КЭДО)", "Формирование и юридически значимое подписание электронных трудовых договоров, соглашений и офферов.")
}

System_Ext(payrollGateway, "Внешняя финансовая система (Payroll Gateway)", "Проверка доступных бюджетов ФОТ, проведение компенсационных выплат, расчёт бонусов за подбор и корпоративный эквайринг.")
System_Ext(notificationProviders, "Внешние провайдеры уведомлений (SendGrid / FCM / SMSC)", "Мультиканальная доставка уведомлений кандидатам и сотрудникам по каналам Email, Push и SMS.")

Rel(candidate, careeriaHiring, "Подача откликов, отслеживание воронки, акцепт оффера", "HTTPS / TLS 1.3")
Rel(recruiter, careeriaHiring, "Ведение воронки найма, планирование встреч, формирование офферов", "HTTPS / TLS 1.3")
Rel(hiringManager, careeriaHiring, "Оценка кандидатов, утверждение офферов", "HTTPS / TLS 1.3")
Rel(companyAdmin, careeriaHiring, "Настройка корпоративных правил и состава рекрутеров", "HTTPS / TLS 1.3")

Rel(candidate, livekitMedia, "Аудио/видео поток онлайн-собеседования", "WebRTC / UDP")
Rel(hiringManager, livekitMedia, "Проведение видеособеседования", "WebRTC / UDP")
Rel(careeriaHiring, livekitMedia, "Инициализация и управление комнатами видеоинтервью", "HTTP / REST API")

Rel(careeriaHiring, iamSystem, "Аутентификация пользователей и валидация JWT-токенов", "OAuth 2.0 / OIDC")
Rel(careeriaHiring, iamSystem, "Проверка гранулярных ReBAC-полномочий", "gRPC / mTLS")
Rel(careeriaHiring, hrSystem, "Синхронизация профилей кандидатов и этапов воронки", "gRPC / REST API")
Rel(hrSystem, careeriaHiring, "События изменения кадровых статусов и позиций", "HTTPS / Webhooks")
Rel(careeriaHiring, kedoSystem, "Передача утверждённых условий оффера для подписания", "HTTPS / REST API")
Rel(kedoSystem, careeriaHiring, "Уведомление о факте подписания трудового договора", "HTTPS / Webhooks")

Rel(careeriaHiring, payrollGateway, "Верификация лимитов ФОТ и фиксация компенсационных пакетов", "HTTPS / REST API")
Rel(careeriaHiring, notificationProviders, "Отправка сервисных сообщений и оповещений", "HTTPS / REST API")

ShowArchitectureLegend()
@enduml
