@startuml member2-deployment
!include <C4/C4_Deployment>
!include ../../../common/styles.puml

title Careeria — Диаграмма развертывания подсистемы Hiring Service (Level 2: Deployment Diagram)
LAYOUT_LEFT_RIGHT()

Deployment_Node(client_node, "Рабочее место пользователя", "Workstation / Smart Device") {
    Container(browser, "Браузер клиента (Web Client)", "React / Next.js SPA", "Обеспечивает графический интерфейс для соискателей и рекрутеров.")
}

Deployment_Node(cloud, "Облачная инфраструктура ЦОД (Enterprise Cloud / Kubernetes Cluster)", "Managed Kubernetes / Linux VM") {
    Deployment_Node(dmz, "Периметральный контур (DMZ / Edge Subnet)", "Public Network Zone") {
        Container(ingress, "Ingress Controller & Reverse Proxy", "Nginx / Envoy", "SSL/TLS-терминация, балансировка нагрузки, rate limiting. Порты 80, 443.")
    }
    
    Deployment_Node(app_subnet, "Приватный контур приложений (Application Subnet / K8s Worker Nodes)", "Private K8s Namespace") {
        Container(api_gateway, "API Gateway Pod", "Go 1.23 / grpc-gateway", "Трансляция REST в gRPC, проверка сессий, трассировка OpenTelemetry. Порт 8080 (HTTP), 50051 (gRPC).")
        
        Deployment_Node(hiring_replicaset, "Hiring Service (K8s ReplicaSet)", "Kubernetes Deployment (2+ Pods)") {
            Container(hiring_pod1, "Hiring Service Pod (Primary)", "Go 1.23+ Binary in Scratch", "Обработка RPC воронки найма, FSM, фоновые воркеры. gRPC порт 50053, Metrics порт 9091.")
            Container(hiring_pod2, "Hiring Service Pod (Replica)", "Go 1.23+ Binary in Scratch", "Горизонтальное масштабирование и балансировка запросов найма. gRPC порт 50053, Metrics порт 9091.")
        }
        
        Container(openfga, "OpenFGA Server Pod", "OpenFGA Engine", "Вычисление ReBAC-графов авторизации отношений. gRPC порт 8081.")
        Container(debezium, "Debezium Connector Pod", "Debezium / Kafka Connect", "Чтение журнала PostgreSQL WAL (CDC) и публикация в Kafka.")
    }
    
    Deployment_Node(data_subnet, "Изолированный контур данных (Storage & Data Subnet)", "Isolated VPC Subnet") {
        Deployment_Node(pg_cluster, "Отказоустойчивый кластер PostgreSQL (Patroni HA)", "High Availability PostgreSQL Cluster") {
            Deployment_Node(pg_master_node, "Сервер БД Master (Primary Node)", "Dedicated Linux VM / Fast NVMe") {
                ContainerDb(hiring_db_master, "Hiring DB (Master)", "PostgreSQL 16", "Основные транзакции на чтение и запись, формирование журнала WAL. Порт 5432.")
            }
            Deployment_Node(pg_replica_node, "Сервер БД Replica (Standby Node)", "Dedicated Linux VM / Fast NVMe") {
                ContainerDb(hiring_db_replica, "Hiring DB (Read Replica)", "PostgreSQL 16", "Горячий резерв, разгрузка тяжелых аналитических выборок. Порт 5432.")
            }
        }
        
        Deployment_Node(kafka_cluster, "Кластер Apache Kafka (KRaft)", "Distributed Event Streaming") {
            ContainerQueue(kafka_broker, "Kafka Brokers (3 Nodes)", "Apache Kafka 3.7+ (KRaft)", "Отказоустойчивая шина доменных событий. Порт 9092.")
        }
    }
}

Deployment_Node(external_infra, "Внешние облачные сервисы и корпоративные узлы", "External SaaS / On-Premise") {
    Container(livekit_cloud, "LiveKit Cloud / WebRTC", "SFU Media Server", "Медиакомнаты для видеоинтервью. Порт 7880 (REST/WS), 7881 (WebRTC UDP).")
    Container(hr_corp_server, "Корпоративная HR-система", "1С:ЗУП / Workday", "Кадровый учет и штатное расписание. Порт 443 (HTTPS).")
}

Rel(browser, ingress, "HTTPS-запросы к веб-интерфейсу", "HTTPS / TLS 1.3, порт 443")
Rel(ingress, api_gateway, "Проксирование запросов к API", "HTTP/1.1, порт 8080")
Rel(api_gateway, hiring_pod1, "gRPC-вызовы к сервису найма", "gRPC / HTTP2, порт 50053")
Rel(api_gateway, hiring_pod2, "gRPC-вызовы (балансировка K8s Service)", "gRPC / HTTP2, порт 50053")
Rel(hiring_pod1, openfga, "Проверка ReBAC-полномочий", "gRPC / mTLS, порт 8081")
Rel(hiring_pod1, hiring_db_master, "Транзакции записи и чтения", "SQL / TCP, порт 5432")
Rel(hiring_pod2, hiring_db_replica, "Чтение истории и аналитики", "SQL / TCP, порт 5432")
Rel(hiring_db_master, hiring_db_replica, "Потоковая физическая репликация WAL", "WAL / TCP, порт 5432")
Rel(hiring_db_master, debezium, "Логическая репликация таблицы outbox", "PostgreSQL WAL (pgoutput), порт 5432")
Rel(debezium, kafka_broker, "Публикация доменных событий найма", "Kafka Protocol / TCP, порт 9092")
Rel(hiring_pod1, livekit_cloud, "Управление комнатами видеоинтервью", "HTTPS / REST API, порт 7880")
Rel(api_gateway, hr_corp_server, "Интеграционные вызовы и вебхуки", "HTTPS / TLS 1.3, порт 443")

ShowArchitectureLegend()
@enduml

