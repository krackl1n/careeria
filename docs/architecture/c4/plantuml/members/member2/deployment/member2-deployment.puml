@startuml member2-deployment
!include <C4/C4_Deployment>
!include ../../../common/styles.puml

title Careeria — Диаграмма развертывания подсистемы Hiring Service (Level 2: Deployment Diagram)
LAYOUT_LEFT_RIGHT()

Deployment_Node(client_node, "Рабочее место пользователя", "Workstation / Smart Device") {
    Container(browser, "Браузер пользователя (Web Client)", "Chromium / WebKit / Gecko Engine", "Выполнение клиентского JS-кода, отображение UI, захват медиапотоков.")
}

Deployment_Node(cloud, "Инфраструктура ЦОД (Kubernetes Cluster)", "Production Kubernetes") {
    Deployment_Node(dmz, "Периметральный контур (DMZ / Edge Subnet)", "careeria-edge namespace") {
        Container(ingress, "Ingress Controller & Reverse Proxy", "Nginx / Envoy", "SSL/TLS-терминация, балансировка нагрузки, rate limiting. Порты 80, 443.")
    }
    
    Deployment_Node(app_subnet, "Приватный контур приложений (Application Subnet)", "careeria-apps namespace") {
        Container(web_app_pod, "Web App Pod × 2..10", "Node.js 20 / Next.js 14", "SSR-рендеринг страниц, раздача статических JS/CSS бандлов. Порт 3000 (HTTP).")
        Container(bff_pod, "BFF Pod × 2..10", "Go 1.23 / net/http, grpc-go", "Сессионный фасад, валидация HttpOnly кук, CSRF защита. Входящий порт 8080 (HTTP), исходящий gRPC порт 50051.")
        Container(api_gateway, "API Gateway Pod × 2..10", "Go 1.23 / grpc-gateway", "Трансляция REST в gRPC, проверка сессий, трассировка OpenTelemetry. Порт 8080 (HTTP), 50051 (gRPC).")
        
        Deployment_Node(hiring_pod_node, "Hiring Service Pods × 2..10", "Kubernetes Deployment / HPA") {
            Container(hiring_svc, "Hiring Service", "Go 1.23+ Binary in Scratch", "Обработка RPC воронки найма, FSM, фоновые воркеры. gRPC порт 50053, Metrics порт 9091.")
        }
        
        Container(openfga, "OpenFGA Server Pod × 2", "OpenFGA Engine", "Вычисление ReBAC-графов авторизации отношений. gRPC порт 8081.")
        Container(debezium, "Debezium Connector Pod × 2", "Debezium / Kafka Connect", "Чтение журнала PostgreSQL WAL (CDC) и публикация в Kafka.")
    }

    Deployment_Node(media_subnet, "Медиа-контур (Media Subnet / Host Network)", "careeria-media namespace") {
        Deployment_Node(livekit_node, "LiveKit Pods × 2..N", "Kubernetes Pod · Host Networking") {
            Container(livekit, "LiveKit Media Server", "LiveKit / WebRTC SFU", "Внутренний медиа-сервер для онлайн-интервью. WSS порт 7880, WebRTC UDP порт 7881.")
        }
    }
    
    Deployment_Node(data_subnet, "Изолированный контур данных (Data Subnet)", "careeria-data namespace") {
        Deployment_Node(pg_statefulset, "PostgreSQL (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerDb(hiring_db, "Hiring DB", "PostgreSQL 16", "Хранение агрегатов найма и таблицы transactional outbox. Без репликации. Порт 5432.")
        }
        
        Deployment_Node(kafka_statefulset, "Kafka Cluster (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerQueue(kafka_broker, "Kafka Brokers (3 Nodes)", "Apache Kafka 3.7+ (KRaft)", "Отказоустойчивая шина доменных событий hiring.events. Порт 9092.")
        }
    }
}

Deployment_Node(external_infra, "Внешние корпоративные системы", "External Enterprise Systems") {
    Container(hr_corp_server, "Корпоративная HR-система", "1С:ЗУП / Workday", "Кадровый учет и штатное расписание. Порт 443 (HTTPS).")
}

Rel(browser, ingress, "HTTPS-запросы (страницы, статика, API)", "HTTPS / TLS 1.3, порт 443")
Rel(browser, livekit, "Прямой медиатрафик видеоинтервью", "WebRTC / UDP, порт 7881")
Rel(ingress, web_app_pod, "Маршрутизация веб-страниц и статики (SSR)", "HTTP/1.1, порт 3000")
Rel(ingress, bff_pod, "Проксирование API-запросов (/api/*)", "HTTP/1.1, порт 8080")
Rel(ingress, livekit, "Сигнализация сессий интервью", "WSS / HTTPS, порт 7880")
Rel(bff_pod, api_gateway, "Авторизованные межсервисные RPC-вызовы", "gRPC / HTTP2, порт 50051")
Rel(api_gateway, hiring_svc, "gRPC-вызовы к сервису найма", "gRPC / HTTP2, порт 50053")
Rel(hiring_svc, openfga, "Проверка ReBAC-полномочий", "gRPC / mTLS, порт 8081")
Rel(hiring_svc, hiring_db, "Транзакции записи и чтения", "SQL / TCP, порт 5432")
Rel(hiring_db, debezium, "Логическая репликация таблицы outbox", "PostgreSQL WAL (pgoutput), порт 5432")
Rel(debezium, kafka_broker, "Публикация доменных событий найма", "Kafka Protocol / TCP, порт 9092")
Rel(hiring_svc, livekit, "Управление комнатами и генерация токенов", "HTTP / REST API, порт 7880")
Rel(api_gateway, hr_corp_server, "Интеграционные вызовы и вебхуки", "HTTPS / TLS 1.3, порт 443")

ShowArchitectureLegend()
@enduml
