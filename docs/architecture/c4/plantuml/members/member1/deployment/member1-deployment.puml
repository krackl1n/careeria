@startuml member1-deployment
!include <C4/C4_Deployment>
!include ../../../common/styles.puml

title Careeria — Диаграмма развертывания подсистемы Candidate Service и Vacancy Service (Level 2: Deployment Diagram)
LAYOUT_LEFT_RIGHT()

Deployment_Node(client_node, "Рабочее место пользователя", "Workstation / Smart Device") {
    Container(browser, "Браузер пользователя (Web Client)", "Chromium / WebKit / Gecko Engine", "Выполнение клиентского JS-кода, отображение UI, загрузка файлов резюме по presigned URL.")
}

Deployment_Node(cloud, "Инфраструктура ЦОД (Kubernetes Cluster)", "Production Kubernetes") {
    Deployment_Node(dmz, "Периметральный контур (DMZ / Edge Subnet)", "careeria-edge namespace") {
        Container(ingress, "Ingress Controller & Reverse Proxy", "Nginx / Envoy", "SSL/TLS-терминация, балансировка нагрузки, rate limiting. Порты 80, 443.")
    }

    Deployment_Node(app_subnet, "Приватный контур приложений (Application Subnet)", "careeria-apps namespace") {
        Container(web_app_pod, "Web App Pod × 2..10", "Node.js 20 / Next.js 14", "SSR-рендеринг страниц, раздача статических JS/CSS бандлов. Порт 3000 (HTTP).")
        Container(bff_pod, "BFF Pod × 2..10", "Go 1.23 / net/http, grpc-go", "Сессионный фасад, валидация HttpOnly кук, CSRF-защита. Входящий порт 8080 (HTTP), исходящий gRPC порт 50051.")
        Container(api_gateway, "API Gateway Pod × 2..10", "Go 1.23 / grpc-gateway", "Трансляция REST в gRPC, проверка сессий, трассировка OpenTelemetry. Порт 8080 (HTTP), 50051 (gRPC).")

        Deployment_Node(candidate_pod_node, "Candidate Service Pods × 2..10", "Kubernetes Deployment / HPA") {
            Container(candidate_svc, "Candidate Service", "Go 1.23+ Binary in Scratch", "Управление профилями, опытом, образованием, навыками и метаданными резюме. gRPC порт 50052, Metrics порт 9091.")
        }

        Deployment_Node(vacancy_pod_node, "Vacancy Service Pods × 2..10", "Kubernetes Deployment / HPA") {
            Container(vacancy_svc, "Vacancy Service", "Go 1.23+ Binary in Scratch", "Жизненный цикл вакансий, требования, условия, компенсация и публикация. gRPC порт 50054, Metrics порт 9092.")
        }

        Container(file_svc, "File Service Pod × 2..10", "Go 1.23 / MinIO Go SDK", "Multipart upload, presigned URL, MIME/size-валидация, antivirus hook и lifecycle файлов. gRPC порт 50055.")
        Container(openfga, "OpenFGA Server Pod × 2", "OpenFGA Engine", "Вычисление ReBAC-графов авторизации доступа к профилям и вакансиям. gRPC порт 8081.")
        Container(debezium, "Debezium Connector Pod × 2", "Debezium / Kafka Connect", "Чтение журнала PostgreSQL WAL (CDC) из таблиц outbox и публикация в Kafka.")
    }

    Deployment_Node(data_subnet, "Изолированный контур данных (Data Subnet)", "careeria-data namespace") {
        Deployment_Node(pg_statefulset, "PostgreSQL (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerDb(candidate_db, "Candidate DB", "PostgreSQL 16", "Профили, статусы поиска, метаданные версий резюме, cleanup jobs и transactional outbox. Порт 5432.")
            ContainerDb(vacancy_db, "Vacancy DB", "PostgreSQL 16", "Вакансии, требования, навыки и transactional outbox. Порт 5432.")
        }

        Deployment_Node(minio_statefulset, "MinIO Object Storage (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerDb(object_storage, "Object Storage", "MinIO / S3 API", "Резюме, аватары и вложения. S3 API порт 9000, Console порт 9001.")
        }

        Deployment_Node(kafka_statefulset, "Kafka Cluster (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerQueue(kafka_broker, "Kafka Brokers (3 Nodes)", "Apache Kafka 3.7+ (KRaft)", "Шина доменных событий candidate.events и vacancy.events. Порт 9092.")
        }
    }
}

Rel(browser, ingress, "HTTPS-запросы (страницы, статика, API)", "HTTPS / TLS 1.3, порт 443")
Rel(browser, object_storage, "Загрузка файла резюме напрямую по presigned URL", "HTTPS / S3 API, порт 9000")
Rel(ingress, web_app_pod, "Маршрутизация веб-страниц и статики (SSR)", "HTTP/1.1, порт 3000")
Rel(ingress, bff_pod, "Проксирование API-запросов (/api/*)", "HTTP/1.1, порт 8080")
Rel(bff_pod, api_gateway, "Авторизованные межсервисные RPC-вызовы", "gRPC / HTTP2, порт 50051")
Rel(api_gateway, candidate_svc, "gRPC-вызовы к сервису профилей кандидатов", "gRPC / HTTP2, порт 50052")
Rel(api_gateway, vacancy_svc, "gRPC-вызовы к сервису вакансий", "gRPC / HTTP2, порт 50054")
Rel(api_gateway, file_svc, "Запрос presigned URL и управление метаданными файлов", "gRPC / HTTP2, порт 50055")
Rel(candidate_svc, openfga, "Проверка ReBAC-полномочий доступа к профилям", "gRPC / mTLS, порт 8081")
Rel(vacancy_svc, openfga, "Проверка ReBAC-полномочий доступа к вакансиям", "gRPC / mTLS, порт 8081")
Rel(candidate_svc, candidate_db, "Транзакции: профиль, резюме, карьерные данные и Outbox", "SQL / TCP, порт 5432")
Rel(vacancy_svc, vacancy_db, "Транзакции: вакансии, требования, жизненный цикл и Outbox", "SQL / TCP, порт 5432")
Rel(candidate_svc, file_svc, "Загружает и связывает файлы резюме с профилем", "gRPC / HTTP2, порт 50055")
Rel(file_svc, object_storage, "Читает и записывает файлы резюме и аватаров", "S3 API / HTTPS, порт 9000")
Rel(candidate_db, debezium, "Логическая репликация таблицы outbox (candidate.events)", "PostgreSQL WAL (pgoutput), порт 5432")
Rel(vacancy_db, debezium, "Логическая репликация таблицы outbox (vacancy.events)", "PostgreSQL WAL (pgoutput), порт 5432")
Rel(debezium, kafka_broker, "Публикация доменных событий кандидатов и вакансий", "Kafka Protocol / TCP, порт 9092")

ShowArchitectureLegend()
@enduml

