@startuml member1-l0-landscape
!include ../../../common/styles.puml
!include ../../../model/elements.puml

title Careeria — Диаграмма системного ландшафта (Level 0): Домен кандидатов и управления вакансиями в ИТ-среде
LAYOUT_LEFT_RIGHT()

' --- Внешние и внутренние акторы макроуровня ---
Person(candidate, "Кандидат", "Внешний соискатель: создаёт профиль, загружает резюме, ищет вакансии и откликается на предложения.")
Person(recruiter, "Рекрутер", "HR-специалист компании: создаёт и публикует вакансии, просматривает профили кандидатов и управляет откликами.")

' --- Граница корпоративного ИТ-ландшафта (Enterprise Boundary) ---
Enterprise_Boundary(enterprise, "Корпоративный ИТ-ландшафт организации и экосистема Careeria") {

    System(candidateVacancyDomain, "Careeria: Домен кандидатов и управления вакансиями", "Целевая подсистема (Member 1): профили кандидатов, резюме, карьерные предпочтения, жизненный цикл вакансий, файловое хранилище и авторизация через OpenFGA.")

    System_Ext(careeriaCore, "Смежные домены Careeria (Найм, Ассессмент, Коммуникации)", "Внутренние продуктовые подсистемы платформы: управление процессом найма и воронкой откликов, тестирование кандидатов и платформа коммуникаций.")

    System_Ext(corporateIam, "Корпоративная служба безопасности и IAM (Keycloak)", "Единый контур аутентификации (SSO), федерация удостоверений и управление учётными записями пользователей платформы.")
}

' --- Внешние системы за пределами корпоративного контура ---
System_Ext(notificationProviders, "Внешние провайдеры уведомлений (SendGrid / FCM / Twilio)", "Внешние облачные шлюзы мультиканальной доставки писем, Push и SMS-оповещений кандидатам.")

System_Ext(objectStorageProvider, "Внешнее объектное хранилище / CDN", "Внешняя инфраструктура хранения и доставки файлов (резюме, аватары, вложения) через S3-совместимый протокол и CDN.")

' --- Взаимодействие пользователей с системами ландшафта ---
Rel(candidate, candidateVacancyDomain, "Создаёт профиль, загружает резюме и ищет вакансии", "HTTPS / TLS 1.3")
Rel(candidate, careeriaCore, "Проходит этапы отбора, тестирование и получает офферы", "HTTPS / TLS 1.3")

Rel(recruiter, candidateVacancyDomain, "Создаёт и публикует вакансии, просматривает профили кандидатов", "HTTPS / TLS 1.3")
Rel(recruiter, careeriaCore, "Ведёт воронку откликов, назначает интервью и формирует офферы", "HTTPS / TLS 1.3")

' --- Межсистемные интеграции внутри корпоративного контура (L0) ---
Rel(candidateVacancyDomain, careeriaCore, "Публикует события профилей и вакансий для смежных доменов", "gRPC / Apache Kafka (Avro)")
Rel(candidateVacancyDomain, corporateIam, "Аутентифицирует пользователей и проверяет федеративные токены", "HTTPS / OAuth 2.0 / OIDC")
Rel(careeriaCore, corporateIam, "Проверяет сессии и учётные записи пользователей", "HTTPS / OAuth 2.0 / OIDC")

' --- Интеграции с внешними системами за пределами ИТ-контура ---
Rel(candidateVacancyDomain, notificationProviders, "Инициирует отправку уведомлений об откликах и изменениях статуса вакансий", "HTTPS / REST API")
Rel(notificationProviders, candidate, "Доставляет уведомления об откликах и новых вакансиях", "Email / Push / SMS")
Rel(candidateVacancyDomain, objectStorageProvider, "Хранит и доставляет файлы резюме и аватаров кандидатов", "HTTPS / S3 API")

ShowArchitectureLegend()
@enduml
