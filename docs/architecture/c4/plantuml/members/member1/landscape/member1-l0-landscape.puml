@startuml member1-l0-landscape
!include ../../../common/styles.puml
!include ../../../model/elements.puml

title Careeria — Диаграмма системного ландшафта (Level 0): Домен компаний и процесса найма в корпоративной ИТ-среде
LAYOUT_LEFT_RIGHT()

' --- Внешние и внутренние акторы макроуровня ---
Person(candidate, "Кандидат", "Внешний соискатель: откликается на вакансии, проходит собеседования и принимает офферы.")
Person(recruiter, "Рекрутер", "HR-специалист компании: ведёт воронку кандидатов, назначает интервью и формирует офферы.")
Person(hiringManager, "Нанимающий руководитель", "Руководитель подразделения: проводит технические интервью, оценивает кандидатов и согласует найм.")
Person(companyAdmin, "Администратор компании", "Управляет профилем работодателя, филиалами, корпоративными ролями и тарифной подпиской.")

' --- Граница корпоративного ИТ-ландшафта (Enterprise Boundary) ---
Enterprise_Boundary(enterprise, "Корпоративный ИТ-ландшафт организации и экосистема Careeria") {

    System(hiringDomain, "Careeria: Домен компаний и процесса найма", "Целевая подсистема (Member 2): профили компаний, корпоративные роли, FSM воронки откликов, собеседования и офферы.")

    System_Ext(careeriaCore, "Смежные домены Careeria (Кандидаты, Вакансии, Ассессмент)", "Внутренние продуктовые подсистемы платформы: каталог вакансий, резюме соискателей, тестирование и коммуникации.")

    System_Ext(corporateIam, "Корпоративная служба безопасности и IAM (Keycloak)", "Единый контур аутентификации (SSO), федерация удостоверений и управление учётными записями сотрудников.")

    System_Ext(employerHr, "Корпоративная HR-система / HCM (1С:ЗУП / Workday)", "Внутрикорпоративная система кадрового учёта, штатного расписания и оформления сотрудников в штат.")
}

' --- Внешние системы за пределами корпоративного контура ---
System_Ext(financialSystem, "Внешняя финансовая система (Банковский эквайринг / Биллинг)", "Проведение B2B-платежей за корпоративные тарифы платформы, расчёт лимитов и сверка транзакций.")

System_Ext(notificationProviders, "Внешние провайдеры уведомлений (SendGrid / FCM / Twilio)", "Внешние облачные шлюзы мультиканальной доставки писем, Push и SMS-оповещений.")

' --- Взаимодействие пользователей с системами ландшафта ---
Rel(candidate, hiringDomain, "Проходит этапы отбора, собеседования и принимает оффер", "HTTPS / TLS 1.3")
Rel(candidate, careeriaCore, "Размещает резюме, ищет вакансии и проходит тесты", "HTTPS / TLS 1.3")

Rel(recruiter, hiringDomain, "Управляет воронкой откликов, интервью и офферами", "HTTPS / TLS 1.3")
Rel(recruiter, employerHr, "Проверяет квоты штатного расписания и кадровые заявки", "HTTPS")

Rel(hiringManager, hiringDomain, "Оценивает кандидатов (SubmitFeedback) и утверждает офферы", "HTTPS / TLS 1.3")
Rel(companyAdmin, hiringDomain, "Настраивает структуру компании, роли сотрудников и тарифы", "HTTPS / TLS 1.3")

' --- Межсистемные интеграции внутри корпоративного контура (L0) ---
Rel(hiringDomain, careeriaCore, "Синхронизирует данные вакансий, профилей кандидатов и оценок", "gRPC / Apache Kafka (Avro)")
Rel(hiringDomain, corporateIam, "Аутентифицирует пользователей и проверяет федеративные токены", "HTTPS / OAuth 2.0 / OIDC")
Rel(careeriaCore, corporateIam, "Проверяет сессии и учётные записи пользователей", "HTTPS / OAuth 2.0 / OIDC")
Rel(employerHr, corporateIam, "Синхронизирует учётные записи сотрудников компании (SSO)", "LDAP / OIDC")
Rel(hiringDomain, employerHr, "Обменивается кадровыми статусами найма и данными принятых кандидатов", "HTTPS / REST / Webhooks")

' --- Интеграции с внешними системами за пределами ИТ-контура ---
Rel(hiringDomain, financialSystem, "Оплата корпоративных подписок работодателя и проверка биллинг-лимитов", "HTTPS / REST API")
Rel(hiringDomain, notificationProviders, "Инициирует отправку транзакционных уведомлений по этапам найма", "HTTPS / REST API")
Rel(notificationProviders, candidate, "Доставляет уведомления о собеседованиях и офферах", "Email / Push / SMS")

ShowArchitectureLegend()
@enduml