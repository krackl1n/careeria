@startuml member1-l0-landscape
!include <C4/C4_Context>
!include ../../../common/styles.puml

title Careeria — Диаграмма системного ландшафта (Level 0): Домен кандидатов и вакансий в корпоративной ИТ-среде
LAYOUT_LEFT_RIGHT()

Person(candidate, "Кандидат", "Внешний соискатель: создаёт профиль, загружает резюме, ищет вакансии и подаёт отклики.")
Person(recruiter, "Рекрутер", "HR-специалист компании: формирует описания вакансий, публикует их и ведёт поиск по базе резюме.")
Person(hiringManager, "Нанимающий руководитель", "Руководитель подразделения: формирует заявки на подбор, согласует требования к вакансиям и оценивает кандидатов.")
Person(companyAdmin, "Администратор компании", "Управляет профилем работодателя, филиалами, корпоративными ролями и тарифной подпиской.")

System_Ext(billingSystem, "Внешняя финансовая система (Банковский эквайринг / Биллинг)", "Проведение B2B-платежей за корпоративные тарифы публикации вакансий и доступа к базе резюме, расчёт лимитов.")
System_Ext(notificationProviders, "Внешние провайдеры уведомлений (SendGrid / FCM / Twilio)", "Внешние облачные шлюзы мультиканальной доставки писем, Push и SMS-оповещений.")

Enterprise_Boundary(enterprise, "Корпоративный ИТ-ландшафт организации и экосистема Careeria") {
    System(targetDomain, "Careeria: Домен кандидатов и вакансий", "Целевая подсистема (Member 1): профили соискателей, загрузка и версионирование резюме, каталог и жизненный цикл вакансий (FSM).")

    System_Ext(adjacentDomains, "Смежные домены Careeria (Компании, Найм, Ассессмент)", "Внутренние продуктовые подсистемы платформы (Member 2, 3, 4): профили компаний, воронка откликов, собеседования, тестирование и чаты.")

    System_Ext(hrSystem, "Корпоративная HR-система / HCM (1С:ЗУП / Workday)", "Внутрикорпоративная система кадрового учёта, штатного расписания, кадровых заявок и оформления сотрудников в штат.")

    System_Ext(iamSystem, "Корпоративная служба безопасности и IAM (Keycloak)", "Единый контур аутентификации (SSO), федерация удостоверений и управление учётными записями пользователей.")
}

Rel(candidate, targetDomain, "Создаёт профиль, загружает резюме и ищет вакансии", "HTTPS / TLS 1.3")
Rel(candidate, adjacentDomains, "Откликается на вакансии, проходит тесты и собеседования", "HTTPS / TLS 1.3")
Rel(recruiter, targetDomain, "Создаёт, настраивает и публикует вакансии, ищет резюме", "HTTPS / TLS 1.3")
Rel(recruiter, hrSystem, "Проверяет квоты штатного расписания и кадровые заявки на вакансии", "HTTPS")
Rel(hiringManager, targetDomain, "Согласует требования к вакансиям и просматривает профили кандидатов", "HTTPS / TLS 1.3")
Rel(companyAdmin, adjacentDomains, "Настраивает структуру компании, роли сотрудников и тарифы", "HTTPS / TLS 1.3")

Rel(targetDomain, adjacentDomains, "Синхронизирует данные опубликованных вакансий, профилей кандидатов и резюме", "gRPC / Apache Kafka (Avro)")
Rel(targetDomain, iamSystem, "Аутентифицирует пользователей и проверяет федеративные токены", "HTTPS / OAuth 2.0 / OIDC")
Rel(adjacentDomains, iamSystem, "Проверяет сессии и учётные записи пользователей", "HTTPS / OAuth 2.0 / OIDC")
Rel(hrSystem, iamSystem, "Синхронизирует учётные записи сотрудников компании (SSO)", "LDAP / OIDC")
Rel(targetDomain, hrSystem, "Импортирует кадровые заявки на открытие вакансий и синхронизирует статусы позиций", "HTTPS / REST / Webhooks")
Rel(targetDomain, billingSystem, "Проверка биллинг-лимитов и оплата корпоративных квот на публикацию вакансий", "HTTPS / REST API")
Rel(targetDomain, notificationProviders, "Инициирует отправку транзакционных уведомлений о публикации резюме и вакансий", "HTTPS / REST API")
Rel(notificationProviders, candidate, "Доставляет уведомления о статусе резюме и подходящих вакансиях", "Email / Push / SMS")

ShowArchitectureLegend()
@enduml