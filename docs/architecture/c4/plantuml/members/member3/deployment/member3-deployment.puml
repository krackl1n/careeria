@startuml member3-deployment
!include <C4/C4_Deployment>
!include ../../../common/styles.puml

title Careeria — Диаграмма развертывания подсистемы оценки, коммуникаций и realtime-взаимодействия (Level 2: Deployment Diagram)
LAYOUT_LEFT_RIGHT()

Deployment_Node(client_node, "Рабочее место пользователя", "Workstation / Smart Device") {
    Container(browser, "Браузер пользователя (Web Client)", "Chromium / WebKit / Gecko Engine", "Выполнение клиентского JS-кода, редактор кода, WebSocket-клиент и WebRTC.")
}

Deployment_Node(cloud, "Инфраструктура ЦОД (Kubernetes Cluster)", "Production Kubernetes") {
    Deployment_Node(dmz, "Периметральный контур (DMZ / Edge Subnet)", "careeria-edge namespace") {
        Container(ingress, "Ingress Controller & Reverse Proxy", "Nginx / Envoy", "SSL/TLS-терминация, балансировка нагрузки, rate limiting. Порты 80, 443.")
    }
    
    Deployment_Node(app_subnet, "Приватный контур приложений (Application Subnet)", "careeria-apps namespace") {
        Container(web_app_pod, "Web App Pod × 2..10", "Node.js 20 / Next.js 14", "SSR-рендеринг страниц, раздача JS/CSS бандлов. Порт 3000 (HTTP).")
        Container(bff_pod, "BFF Pod × 2..10", "Go 1.23 / net/http, grpc-go", "Сессионный фасад, валидация HttpOnly кук, CSRF защита. Входящий порт 8080 (HTTP), исходящий gRPC порт 50051.")
        Container(api_gateway, "API Gateway Pod × 2..10", "Go 1.23 / grpc-gateway", "Трансляция REST в gRPC, проверка сессий, трассировка OpenTelemetry. Порт 8080 (HTTP), 50051 (gRPC).")
        
        Deployment_Node(assessment_pod_node, "Assessment Service Pods × 2..10", "Kubernetes Deployment / HPA") {
            Container(assessment_svc, "Assessment Service", "Go 1.23+ Binary in Scratch", "Управление заданиями, FSM сессий, скоринговые стратегии. gRPC порт 50055, Metrics порт 9091.")
        }
        
        Deployment_Node(comm_pod_node, "Communication Service Pods × 2..10", "Kubernetes Deployment / HPA") {
            Container(comm_svc, "Communication Service", "Go 1.23+ Binary in Scratch", "Диалоги, сообщения, вложения, отметки прочтения. gRPC порт 50056, Metrics порт 9091.")
        }
        
        Deployment_Node(runner_pod_node, "Code Execution Runner Pods × 2..10", "Kubernetes Deployment / Isolated Worker Nodes") {
            Container(code_runner, "Code Execution Runner", "Go 1.23 / gVisor runsc Sandbox", "Изолированная среда сборки и прогона юнит-тестов решений соискателей. gRPC порт 50060.")
        }
        
        Container(realtime_publisher, "Realtime Publisher Pods × 2..8", "Go 1.23 / Kafka Consumer", "Вычитывает события из Kafka и публикует realtime-сообщения в Centrifugo API.")
        Container(openfga, "OpenFGA Server Pod × 2", "OpenFGA Engine", "Вычисление ReBAC-графов авторизации отношений (can_submit, can_evaluate). gRPC порт 8081.")
        Container(debezium, "Debezium Connector Pod × 2", "Debezium / Kafka Connect", "Чтение журнала PostgreSQL WAL (CDC) и публикация в Kafka.")
    }

    Deployment_Node(media_subnet, "Медиа- и Realtime-контур (Media & Realtime Subnet)", "careeria-media namespace") {
        Deployment_Node(livekit_node, "LiveKit Pods × 2..N", "Kubernetes Pod · Host Networking") {
            Container(livekit, "LiveKit Media Server", "LiveKit / WebRTC SFU", "Внутренний медиа-сервер для онлайн-интервью и Live Coding. WSS порт 7880, WebRTC UDP порт 7881.")
        }
        
        Deployment_Node(centrifugo_node, "Centrifugo Pods × 2..5", "Kubernetes Pod / Stateless HPA") {
            Container(centrifugo, "Centrifugo Server", "Centrifugo v5 Engine", "WebSocket/SSE сервер push-уведомлений и чата в реальном времени. HTTP API порт 8000, WSS порт 8000.")
        }
    }
    
    Deployment_Node(data_subnet, "Изолированный контур данных (Data Subnet)", "careeria-data namespace") {
        Deployment_Node(pg_statefulset, "PostgreSQL (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerDb(postgresql, "PostgreSQL", "PostgreSQL 16", "Инстанс БД: базы данных Assessment DB и Communication DB, таблицы transactional outbox. Без репликации. Порт 5432.")
        }
        
        Deployment_Node(redis_statefulset, "Redis Engine (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerDb(redis, "Redis Cluster / Sentinel", "Redis 7.2", "Pub/Sub шина синхронизации нод Centrifugo и presence. Порт 6379.")
        }
        
        Deployment_Node(kafka_statefulset, "Kafka Cluster (StatefulSet)", "Kubernetes StatefulSet") {
            ContainerQueue(kafka_broker, "Kafka Brokers (3 Nodes)", "Apache Kafka 3.7+ (KRaft)", "Отказоустойчивая шина доменных событий assessment.events и communication.events. Порт 9092.")
        }
    }
}

Rel(browser, ingress, "HTTPS-запросы (страницы, статика, API)", "HTTPS / TLS 1.3, порт 443")
Rel(browser, livekit, "Прямой медиатрафик Live Coding и видео", "WebRTC / UDP, порт 7881")
Rel(browser, centrifugo, "Постоянное WebSocket-соединение чата и realtime-пушей", "WSS / HTTPS, порт 8000")
Rel(ingress, web_app_pod, "Маршрутизация веб-страниц и статики (SSR)", "HTTP/1.1, порт 3000")
Rel(ingress, bff_pod, "Проксирование API-запросов (/api/*)", "HTTP/1.1, порт 8080")
Rel(ingress, livekit, "Сигнализация сессий LiveKit", "WSS / HTTPS, порт 7880")
Rel(ingress, centrifugo, "Проксирование WebSocket соединений клиентов", "WSS / HTTPS, порт 8000")
Rel(bff_pod, api_gateway, "Авторизованные межсервисные RPC-вызовы", "gRPC / HTTP2, порт 50051")
Rel(api_gateway, assessment_svc, "gRPC-вызовы к сервису оценки", "gRPC / HTTP2, порт 50055")
Rel(api_gateway, comm_svc, "gRPC-вызовы к сервису коммуникаций", "gRPC / HTTP2, порт 50056")
Rel(assessment_svc, openfga, "Проверка ReBAC-полномочий", "gRPC / mTLS, порт 8081")
Rel(comm_svc, openfga, "Проверка ReBAC-доступа к диалогам", "gRPC / mTLS, порт 8081")
Rel(assessment_svc, code_runner, "Изолированное исполнение кода решений", "gRPC / HTTP2, порт 50060")
Rel(assessment_svc, postgresql, "Транзакции сессий и Outbox (Assessment DB)", "SQL / TCP, порт 5432")
Rel(comm_svc, postgresql, "Транзакции сообщений и Outbox (Communication DB)", "SQL / TCP, порт 5432")
Rel(postgresql, debezium, "CDC-репликация таблиц outbox", "PostgreSQL WAL (pgoutput), порт 5432")
Rel(debezium, kafka_broker, "Публикация доменных событий (Avro)", "Kafka Protocol / TCP, порт 9092")
Rel(realtime_publisher, kafka_broker, "Вычитывание событий для realtime-рассылки", "Kafka Protocol / TCP, порт 9092")
Rel(realtime_publisher, centrifugo, "Публикация в каналы пользователей и компаний", "Centrifugo HTTP API, порт 8000")
Rel(centrifugo, redis, "Pub/Sub синхронизация между Centrifugo нодами", "Redis Protocol / TCP, порт 6379")
Rel(assessment_svc, livekit, "Создание комнат Live Coding и генерация JWT", "HTTP / REST API, порт 7880")

ShowArchitectureLegend()
@enduml
