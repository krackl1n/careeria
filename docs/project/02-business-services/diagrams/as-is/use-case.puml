@startuml use-case
title Диаграмма вариантов использования\nСценарии взаимодействия акторов в процессах подбора и квалификационной оценки персонала

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
  BackgroundColor #EBF8FF
  BorderColor #2B6CB0
  FontColor #1A202C
}

skinparam usecase {
  BackgroundColor White
  BorderColor #4A5568
  ArrowColor #2D3748
  FontColor #1A202C
}

actor "Кандидат" as Candidate
actor "Сотрудник компании" as Employee
actor "Рекрутер" as Recruiter
actor "Нанимающий руководитель" as HiringManager
actor "Администратор компании" as CompanyAdmin

Recruiter -up-|> Employee
HiringManager -up-|> Employee
CompanyAdmin -up-|> Employee

actor "Работный сайт" as JobBoard <<Система>> #EDF2F7
actor "Сторонняя платформа оценки кода" as CodePlatform <<Система>> #EDF2F7
actor "Внешняя платформа ВКС" as VideoPlatform <<Система>> #EDF2F7
actor "Сторонний мессенджер" as Messenger <<Система>> #EDF2F7
actor "Корпоративная учётная система" as HRIS <<Система>> #EDF2F7


rectangle "Информационный контур процессов подбора и оценки персонала" as SystemBoundary {

  ' Работа с вакансиями и откликами
  usecase "Опубликовать вакансию" as UC_PostVacancy
  usecase "Подать отклик на вакансию" as UC_Apply
  usecase "Прикрепить портфолио к отклику" as UC_AttachPortfolio
  usecase "Зарегистрировать кандидата в реестре" as UC_RegisterCandidate

  ' Коммуникация и скрининг
  usecase "Отправлять сообщения в стороннем мессенджере" as UC_SendMessage
  usecase "Прикрепить файл к сообщению" as UC_AttachFile
  usecase "Провести первичный скрининг резюме" as UC_ScreenResume
  usecase "Согласовать кандидатуру соискателя" as UC_ApproveCandidate
  usecase "Обсудить кандидатуру соискателя" as UC_DiscussCandidate

  ' Организация и проведение интервью
  usecase "Назначить собеседование" as UC_ScheduleInterview
  usecase "Сгенерировать ссылку на видеовстречу" as UC_GenerateLink
  usecase "Провести собеседование" as UC_ConductInterview
  usecase "Провести первичное интервью" as UC_ScreenInterview
  usecase "Провести техническое интервью" as UC_TechInterview
  usecase "Выполнить задание по лайвкодингу на сторонней платформе" as UC_LiveCoding
  usecase "Заполнить форму оценки кандидата" as UC_EvaluateCandidate

  ' Принятие решений и завершение подбора
  usecase "Направить предложение о работе" as UC_SendOffer
  usecase "Направить отказ соискателю" as UC_SendRejection
  usecase "Перенести данные соискателя в кадровый учёт" as UC_TransferHRIS

  ' Администрирование и отчётность
  usecase "Сформировать отчётность по воронке подбора" as UC_GenerateReport
  usecase "Консолидировать данные из реестров" as UC_ConsolidateData
  usecase "Настроить параметры корпоративного доступа" as UC_ManageAccess
}


Candidate -- UC_Apply
Candidate -- UC_SendMessage
Candidate -- UC_ConductInterview
Candidate -- UC_LiveCoding

Recruiter -- UC_PostVacancy
Recruiter -- UC_RegisterCandidate
Recruiter -- UC_ScreenResume
Recruiter -- UC_ScheduleInterview
Recruiter -- UC_SendOffer
Recruiter -- UC_SendRejection
Recruiter -- UC_TransferHRIS

HiringManager -- UC_ApproveCandidate
HiringManager -- UC_EvaluateCandidate

Employee -- UC_DiscussCandidate
Employee -- UC_ConductInterview
Employee -- UC_SendMessage

CompanyAdmin -- UC_GenerateReport
CompanyAdmin -- UC_ManageAccess

UC_PostVacancy -- JobBoard
UC_Apply -- JobBoard
UC_SendMessage -- Messenger
UC_GenerateLink -- VideoPlatform
UC_ConductInterview -- VideoPlatform
UC_LiveCoding -- CodePlatform
UC_TransferHRIS -- HRIS

UC_ScreenInterview -up-|> UC_ConductInterview
UC_TechInterview -up-|> UC_ConductInterview

UC_RegisterCandidate ..> UC_ScreenResume : <<include>>
UC_ScheduleInterview ..> UC_GenerateLink : <<include>>
UC_GenerateReport ..> UC_ConsolidateData : <<include>>


UC_AttachPortfolio ..> UC_Apply : <<extend>>
UC_AttachFile ..> UC_SendMessage : <<extend>>
UC_LiveCoding ..> UC_TechInterview : <<extend>>

@enduml
