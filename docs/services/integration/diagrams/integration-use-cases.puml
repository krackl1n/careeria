@startuml integration-use-cases
left to right direction
skinparam shadowing false
skinparam defaultFontName sans-serif
actor "Администратор\nинтеграции" as admin
actor "Внешняя HR-система" as hr
actor "Внутренние\nсобытия Kafka" as kafka
actor "Delivery Worker" as worker
rectangle "Integration Service" {
 usecase "Управлять подключением\nи ключами" as connection
 usecase "Управлять и проверять\nподписку" as subscription
 usecase "Просмотреть журналы,\nотменить / повторить" as audit
 usecase "Принять входящий\nwebhook" as inbound
 usecase "Спланировать исходящие\nдоставки" as plan
 usecase "Доставить / повторить\nwebhook" as delivery
}
admin -- connection
admin -- subscription
admin -- audit
hr -- inbound
hr -- delivery
kafka -- plan
worker -- delivery
@enduml
