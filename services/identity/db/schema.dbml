Project careeria_identity {
  database_type: 'PostgreSQL'
  Note: 'Identity Service schema. Source of truth: db/migrations/*.sql.'
}

Enum public.identity_status {
  pending
  active
  disabled
  deleted
}

Enum public.identity_profile_source {
  self_declared
  provisioned
  verified
}

Enum public.identity_assurance_level {
  self_declared
  organization_asserted
  identity_verified
}

Enum public.mfa_factor_type {
  totp
  webauthn
}

Enum public.totp_algorithm {
  sha1
  sha256
  sha512
}

Enum public.authentication_level {
  single_factor
  multi_factor
}

Enum public.oauth_client_type {
  public
  confidential
}

Enum public.oauth_consent_mode {
  required
  remember
  trusted
}

Enum public.oauth_authorization_grant_source {
  user_consent
  trusted_client_policy
}

Enum public.oauth_token_endpoint_auth_method {
  none
  client_secret_basic
}

Enum public.oauth_grant_type {
  authorization_code
  refresh_token
}

Enum public.oauth_client_status {
  active
  disabled
  deleted
}

Enum public.signing_key_status {
  pending
  active
  retiring
  retired
  compromised
}

Enum public.service_account_status {
  active
  disabled
  deleted
}

Enum public.service_account_credential_type {
  shared_secret
}

Enum public.security_event_result {
  success
  failure
  blocked
}

Enum public.security_actor_type {
  anonymous
  identity
  service_account
  administrator
  system
}

Table public.identities {
  id uuid [pk]
  status public.identity_status [not null, default: 'pending']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    status [name: 'identities_status_idx']
    deleted_at [name: 'identities_deleted_at_idx', note: 'WHERE deleted_at IS NOT NULL']
  }

  Note: 'CHECK: deleted status requires deleted_at; updated_at >= created_at.'
}

Table public.identity_profiles {
  identity_id uuid [pk]

  family_name text [not null]
  given_name text [not null]
  middle_name text

  source public.identity_profile_source [not null, default: 'self_declared']
  assurance_level public.identity_assurance_level [not null, default: 'self_declared']

  version bigint [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '''
    One-to-one identity profile.
    Names are trimmed and must not be blank.
    The application increments version on every profile change.
  '''
}

Table public.identity_emails {
  id uuid [pk]
  identity_id uuid [not null]
  email text [not null]
  is_primary boolean [not null, default: false]
  verified_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    email [unique, name: 'identity_emails_email_uidx']
    identity_id [name: 'identity_emails_identity_idx']
    identity_id [unique, name: 'identity_emails_primary_uidx', note: 'WHERE is_primary AND deleted_at IS NULL']
  }

  Note: 'Email and identity_id are immutable. Email is normalized to lowercase; primary contact cannot be deleted.'
}

Table public.identity_phones {
  id uuid [pk]
  identity_id uuid [not null]
  phone text [not null]
  is_primary boolean [not null, default: false]
  verified_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    phone [unique, name: 'identity_phones_phone_uidx']
    identity_id [name: 'identity_phones_identity_idx']
    identity_id [unique, name: 'identity_phones_primary_uidx', note: 'WHERE is_primary AND deleted_at IS NULL']
  }

  Note: 'Phone and identity_id are immutable. Phone uses E.164 format; primary contact cannot be deleted.'
}

Table public.external_identity_accounts {
  id uuid [pk]
  identity_id uuid [not null]
  provider text [not null]
  subject text [not null]
  linked_at timestamptz [not null]
  last_authenticated_at timestamptz
  disabled_at timestamptz
  deleted_at timestamptz

  indexes {
    (provider, subject) [unique, name: 'external_identity_accounts_provider_subject_uidx']
    identity_id [name: 'external_identity_accounts_identity_idx']
  }

  Note: 'identity_id, provider, subject and linked_at are immutable.'
}

Table public.identity_password_credentials {
  identity_id uuid [pk]
  password_hash text [not null]
  must_change boolean [not null, default: false]
  password_updated_at timestamptz [not null]
  expires_at timestamptz
  compromised_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.identity_password_auth_state {
  identity_id uuid [pk]
  failed_attempts integer [not null, default: 0]
  last_failed_at timestamptz
  locked_until timestamptz
  lock_reason text
  updated_at timestamptz [not null]

  indexes {
    locked_until [name: 'identity_password_auth_state_locked_until_idx', note: 'WHERE locked_until IS NOT NULL']
  }

  Note: 'locked_until and lock_reason are set or cleared together.'
}

Table public.mfa_factors {
  id uuid [pk]
  identity_id uuid [not null]
  factor_type public.mfa_factor_type [not null]
  name text
  is_primary boolean [not null, default: false]
  confirmed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  last_used_at timestamptz
  disabled_at timestamptz

  indexes {
    (id, factor_type) [unique, name: 'mfa_factors_id_type_uk']
    identity_id [name: 'mfa_factors_identity_idx']
    identity_id [unique, name: 'mfa_factors_primary_uidx', note: 'WHERE is_primary AND confirmed_at IS NOT NULL AND disabled_at IS NULL']
    identity_id [unique, name: 'mfa_factors_enabled_totp_uidx', note: "WHERE factor_type = 'totp' AND disabled_at IS NULL"]
  }

  Note: 'identity_id, factor_type and created_at are immutable.'
}

Table public.totp_factors {
  factor_id uuid [pk]
  factor_type public.mfa_factor_type [not null, default: 'totp']
  secret_encrypted bytea [not null]
  encryption_key_ref text [not null]
  algorithm public.totp_algorithm [not null, default: 'sha1']
  digits smallint [not null, default: 6]
  period_seconds smallint [not null, default: 30]
  last_used_time_step bigint
  updated_at timestamptz [not null]

  Note: 'Subtype of mfa_factors; factor_type must be totp.'
}

Table public.webauthn_credentials {
  factor_id uuid [pk]
  factor_type public.mfa_factor_type [not null, default: 'webauthn']
  credential_id bytea [not null]
  public_key bytea [not null]
  sign_count bigint [not null, default: 0]
  aaguid uuid
  transports text[] [not null, default: '{}']
  backup_eligible boolean [not null, default: false]
  backup_state boolean [not null, default: false]
  created_at timestamptz [not null]
  last_used_at timestamptz

  indexes {
    credential_id [unique, name: 'webauthn_credentials_credential_id_uidx']
  }

  Note: 'Subtype of mfa_factors; factor_type must be webauthn.'
}

Table public.recovery_code_sets {
  id uuid [pk]
  identity_id uuid [not null]
  created_at timestamptz [not null]
  expires_at timestamptz
  disabled_at timestamptz

  indexes {
    identity_id [name: 'recovery_code_sets_identity_idx']
    identity_id [unique, name: 'recovery_code_sets_active_uidx', note: 'WHERE disabled_at IS NULL']
  }

  Note: 'identity_id and created_at are immutable.'
}

Table public.recovery_codes {
  id uuid [pk]
  set_id uuid [not null]
  code_hash text [not null]
  created_at timestamptz [not null]
  used_at timestamptz

  indexes {
    (set_id, code_hash) [unique, name: 'recovery_codes_set_hash_uidx']
    set_id [name: 'recovery_codes_unused_idx', note: 'WHERE used_at IS NULL']
  }

  Note: 'set_id, code_hash and created_at are immutable.'
}

Table public.email_verification_challenges {
  id uuid [pk]
  email_id uuid [not null]
  token_hash text [not null]
  attempts integer [not null, default: 0]
  max_attempts integer [not null]
  expires_at timestamptz [not null]
  last_attempt_at timestamptz
  consumed_at timestamptz
  revoked_at timestamptz
  requested_from_ip inet
  consumed_from_ip inet
  created_at timestamptz [not null]

  indexes {
    token_hash [unique, name: 'email_verification_challenges_token_uidx']
    (email_id, created_at) [name: 'email_verification_challenges_email_idx']
    expires_at [name: 'email_verification_challenges_expires_idx', note: 'WHERE consumed_at IS NULL AND revoked_at IS NULL']
  }
}

Table public.phone_verification_challenges {
  id uuid [pk]
  phone_id uuid [not null]
  token_hash text [not null]
  attempts integer [not null, default: 0]
  max_attempts integer [not null]
  expires_at timestamptz [not null]
  last_attempt_at timestamptz
  consumed_at timestamptz
  revoked_at timestamptz
  requested_from_ip inet
  consumed_from_ip inet
  created_at timestamptz [not null]

  indexes {
    token_hash [unique, name: 'phone_verification_challenges_token_uidx']
    (phone_id, created_at) [name: 'phone_verification_challenges_phone_idx']
    expires_at [name: 'phone_verification_challenges_expires_idx', note: 'WHERE consumed_at IS NULL AND revoked_at IS NULL']
  }
}

Table public.password_reset_challenges {
  id uuid [pk]
  identity_id uuid [not null]
  token_hash text [not null]
  attempts integer [not null, default: 0]
  max_attempts integer [not null]
  expires_at timestamptz [not null]
  last_attempt_at timestamptz
  consumed_at timestamptz
  revoked_at timestamptz
  requested_from_ip inet
  consumed_from_ip inet
  created_at timestamptz [not null]

  indexes {
    token_hash [unique, name: 'password_reset_challenges_token_uidx']
    (identity_id, created_at) [name: 'password_reset_challenges_identity_idx']
    expires_at [name: 'password_reset_challenges_expires_idx', note: 'WHERE consumed_at IS NULL AND revoked_at IS NULL']
  }
}

Table public.oauth_clients {
  id uuid [pk]
  client_id text [not null]
  client_type public.oauth_client_type [not null]
  token_endpoint_auth_method public.oauth_token_endpoint_auth_method [not null]
  name text [not null]
  description text
  require_pkce boolean [not null, default: true]
  consent_mode public.oauth_consent_mode [not null, default: 'remember']
  status public.oauth_client_status [not null, default: 'active']
  created_by_identity_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  disabled_at timestamptz
  deleted_at timestamptz

  indexes {
    client_id [unique, name: 'oauth_clients_client_id_uidx']
    (id, client_type) [unique, name: 'oauth_clients_id_type_uk']
    created_by_identity_id [name: 'oauth_clients_created_by_identity_idx', note: 'WHERE created_by_identity_id IS NOT NULL']
  }

  Note: 'public clients require PKCE. client_id, client_type, auth method and created_at are immutable.'
}

Table public.oauth_client_redirect_uris {
  id uuid [pk]
  oauth_client_id uuid [not null]
  redirect_uri text [not null]
  created_at timestamptz [not null]

  indexes {
    (oauth_client_id, redirect_uri) [unique, name: 'oauth_client_redirect_uris_client_uri_uk']
  }
}

Table public.oauth_client_post_logout_redirect_uris {
  id uuid [pk]
  oauth_client_id uuid [not null]
  post_logout_redirect_uri text [not null]
  created_at timestamptz [not null]

  indexes {
    (oauth_client_id, post_logout_redirect_uri) [unique, name: 'oauth_client_post_logout_redirect_uris_client_uri_uk']
  }
}

Table public.oauth_client_grant_types {
  oauth_client_id uuid [not null]
  grant_type public.oauth_grant_type [not null]
  created_at timestamptz [not null]

  indexes {
    (oauth_client_id, grant_type) [pk, name: 'oauth_client_grant_types_pk']
  }
}

Table public.oauth_client_scopes {
  oauth_client_id uuid [not null]
  scope text [not null]
  created_at timestamptz [not null]

  indexes {
    (oauth_client_id, scope) [pk, name: 'oauth_client_scopes_pk']
  }

  Note: 'Maximum scopes this OAuth client is allowed to request; this is not a user consent.'
}

Table public.oauth_client_credentials {
  id uuid [pk]
  oauth_client_id uuid [not null]
  client_type public.oauth_client_type [not null, default: 'confidential']
  secret_hash text [not null]
  name text
  created_by_identity_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  expires_at timestamptz
  revoked_at timestamptz
  revoke_reason text
  last_used_at timestamptz

  indexes {
    (oauth_client_id, created_at) [name: 'oauth_client_credentials_client_idx']
    created_by_identity_id [name: 'oauth_client_credentials_created_by_identity_idx', note: 'WHERE created_by_identity_id IS NOT NULL']
  }

  Note: 'Only confidential clients can have credentials. Secret and protocol identity are immutable.'
}

Table public.oauth_authorization_grants {
  id uuid [pk]
  identity_id uuid [not null]
  oauth_client_id uuid [not null]
  source public.oauth_authorization_grant_source [not null]
  granted_at timestamptz [not null]
  updated_at timestamptz [not null]
  expires_at timestamptz
  revoked_at timestamptz

  indexes {
    (identity_id, oauth_client_id) [unique, name: 'oauth_authorization_grants_identity_client_uk']
    identity_id [name: 'oauth_authorization_grants_identity_idx', note: 'WHERE revoked_at IS NULL']
    oauth_client_id [name: 'oauth_authorization_grants_client_idx', note: 'WHERE revoked_at IS NULL']
  }

  Note: 'Current remembered authorization between one identity and one OAuth client. This is separate from client configuration and from a single authorization transaction.'
}

Table public.oauth_authorization_grant_scopes {
  grant_id uuid [not null]
  scope text [not null]
  granted_at timestamptz [not null]

  indexes {
    (grant_id, scope) [pk, name: 'oauth_authorization_grant_scopes_pk']
  }


  Note: 'Scopes remembered for the identity-client authorization grant. They must remain a subset of oauth_client_scopes.'
}

Table public.sessions {
  id uuid [pk]
  identity_id uuid [not null]
  oauth_client_id uuid [not null]
  authentication_level public.authentication_level [not null]
  authenticated_methods text[] [not null, note: 'Allowed values: password, totp, webauthn, recovery_code']
  ip_address inet
  user_agent text
  device_name text
  created_at timestamptz [not null]
  authenticated_at timestamptz [not null]
  last_seen_at timestamptz
  idle_expires_at timestamptz [not null]
  absolute_expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason text

  indexes {
    (identity_id, created_at) [name: 'sessions_identity_idx']
    (oauth_client_id, created_at) [name: 'sessions_oauth_client_idx']
    idle_expires_at [name: 'sessions_idle_expires_idx', note: 'WHERE revoked_at IS NULL']
    absolute_expires_at [name: 'sessions_absolute_expires_idx', note: 'WHERE revoked_at IS NULL']
  }

  Note: 'Authentication identity, client binding and absolute expiration are immutable.'
}

Table public.session_scopes {
  session_id uuid [not null]
  scope text [not null]

  indexes {
    (session_id, scope) [pk, name: 'session_scopes_pk']
  }

  Note: 'Snapshot of scopes granted when the session was created.'
}

Table public.refresh_token_families {
  id uuid [pk]
  session_id uuid [not null, unique]
  created_at timestamptz [not null]
  last_rotated_at timestamptz
  absolute_expires_at timestamptz [not null]
  reuse_detected_at timestamptz
  revoked_at timestamptz
  revoke_reason text

  indexes {
    absolute_expires_at [name: 'refresh_token_families_expires_idx', note: 'WHERE revoked_at IS NULL']
  }

  Note: 'Session binding, creation time and absolute expiration are immutable.'
}

Table public.refresh_tokens {
  id uuid [pk]
  family_id uuid [not null]
  parent_token_id uuid
  token_hash text [not null]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  rotated_at timestamptz
  revoked_at timestamptz
  revoke_reason text
  reuse_detected_at timestamptz
  created_from_ip inet
  created_user_agent text

  indexes {
    (id, family_id) [unique, name: 'refresh_tokens_id_family_uk']
    token_hash [unique, name: 'refresh_tokens_hash_uidx']
    family_id [unique, name: 'refresh_tokens_current_family_uidx', note: 'WHERE rotated_at IS NULL AND revoked_at IS NULL']
    parent_token_id [unique, name: 'refresh_tokens_parent_uidx', note: 'WHERE parent_token_id IS NOT NULL']
    (family_id, issued_at) [name: 'refresh_tokens_family_issued_idx']
    expires_at [name: 'refresh_tokens_expires_idx', note: 'WHERE rotated_at IS NULL AND revoked_at IS NULL']
  }

  Note: 'Parent must belong to the same family. Token identity and issuance data are immutable.'
}

Table public.signing_keys {
  id uuid [pk]
  kid text [not null]
  algorithm text [not null]
  public_jwk jsonb [not null]
  private_key_ref text [not null]
  status public.signing_key_status [not null, default: 'pending']
  created_at timestamptz [not null]
  not_before timestamptz [not null]
  activated_at timestamptz
  retiring_at timestamptz
  retired_at timestamptz
  expires_at timestamptz
  compromised_at timestamptz

  indexes {
    kid [unique, name: 'signing_keys_kid_uidx']
    algorithm [unique, name: 'signing_keys_active_algorithm_uidx', note: "WHERE status = 'active'"]
    (status, not_before, expires_at) [name: 'signing_keys_jwks_idx', note: "WHERE status IN ('active', 'retiring')"]
  }

  Note: 'public_jwk rejects private JWK parameters; private material is referenced externally.'
}

Table public.service_accounts {
  id uuid [pk]
  organization_id uuid [not null, note: 'Owned by Organization Service']
  account_key text [not null]
  name text [not null]
  description text
  status public.service_account_status [not null, default: 'active']
  created_by_identity_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  disabled_at timestamptz
  deleted_at timestamptz

  indexes {
    (organization_id, account_key) [unique, name: 'service_accounts_org_key_uidx']
    (organization_id, id) [name: 'service_accounts_org_active_idx', note: "WHERE status = 'active'"]
    deleted_at [name: 'service_accounts_deleted_at_idx', note: 'WHERE deleted_at IS NOT NULL']
    created_by_identity_id [name: 'service_accounts_created_by_identity_idx', note: 'WHERE created_by_identity_id IS NOT NULL']
  }

  Note: 'organization_id, account_key and created_at are immutable.'
}

Table public.service_account_credentials {
  id uuid [pk]
  service_account_id uuid [not null]
  credential_type public.service_account_credential_type [not null, default: 'shared_secret']
  secret_hash text [not null]
  secret_prefix text
  name text
  created_by_identity_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  expires_at timestamptz
  revoked_at timestamptz
  revoke_reason text
  last_used_at timestamptz

  indexes {
    (service_account_id, created_at) [name: 'service_account_credentials_account_idx']
    created_by_identity_id [name: 'service_account_credentials_created_by_identity_idx', note: 'WHERE created_by_identity_id IS NOT NULL']
    secret_prefix [name: 'service_account_credentials_prefix_idx', note: 'WHERE secret_prefix IS NOT NULL AND revoked_at IS NULL']
  }

  Note: 'Credential binding, type, secret hash and created_at are immutable.'
}

Table public.security_events {
  id uuid [pk]
  event_type text [not null]
  result public.security_event_result [not null]
  actor_type public.security_actor_type [not null]
  identity_id uuid
  service_account_id uuid
  session_id uuid
  oauth_client_id uuid
  identifier_hash bytea
  ip_address inet
  user_agent text
  correlation_id uuid
  occurred_at timestamptz [not null]
  metadata jsonb [not null, default: '{}']

  indexes {
    (identity_id, occurred_at) [name: 'security_events_identity_idx', note: 'WHERE identity_id IS NOT NULL']
    (service_account_id, occurred_at) [name: 'security_events_service_account_idx', note: 'WHERE service_account_id IS NOT NULL']
    (session_id, occurred_at) [name: 'security_events_session_idx', note: 'WHERE session_id IS NOT NULL']
    (oauth_client_id, occurred_at) [name: 'security_events_oauth_client_idx', note: 'WHERE oauth_client_id IS NOT NULL']
    (event_type, occurred_at) [name: 'security_events_type_idx']
    (identifier_hash, occurred_at) [name: 'security_events_identifier_idx', note: 'WHERE identifier_hash IS NOT NULL']
    occurred_at [name: 'security_events_occurred_at_idx']
    (correlation_id, occurred_at) [name: 'security_events_correlation_idx', note: 'WHERE correlation_id IS NOT NULL']
  }

  Note: 'Actor type determines whether identity_id or service_account_id must be present.'
}

Table public.outbox_messages {
  id uuid [pk]
  event_id uuid [not null]
  aggregate_type varchar(255) [not null]
  aggregate_id uuid [not null]
  aggregate_version bigint
  event_type varchar(255) [not null]
  payload jsonb [not null]
  headers jsonb [not null, default: `'{}'::jsonb`]
  partition_key varchar(255)
  status varchar(32) [not null, default: 'PENDING']
  attempts integer [not null, default: 0]
  occurred_at timestamptz [not null]
  processing_started_at timestamptz
  published_at timestamptz
  next_attempt_at timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    event_id [unique, name: 'ux_outbox_messages_event_id']
    (aggregate_type, aggregate_id, aggregate_version) [name: 'ix_outbox_messages_aggregate']
    (status, next_attempt_at, occurred_at) [name: 'ix_outbox_messages_processing', note: "WHERE status IN ('PENDING', 'FAILED')"]
    processing_started_at [name: 'ix_outbox_messages_stuck_processing', note: "WHERE status = 'PROCESSING'"]
    (partition_key, occurred_at) [name: 'ix_outbox_messages_partition', note: "WHERE status = 'PENDING'"]
    published_at [name: 'ix_outbox_messages_published_at', note: "WHERE status = 'PUBLISHED'"]
  }

  Note: 'Transactional outbox. Payload and headers are JSON objects; processing state controls retries and publication.'
}

Ref identity_emails_identity_fk: public.identity_emails.identity_id > public.identities.id [delete: cascade]
Ref identity_profiles_identity_fk: public.identity_profiles.identity_id - public.identities.id [delete: cascade]
Ref identity_phones_identity_fk: public.identity_phones.identity_id > public.identities.id [delete: cascade]
