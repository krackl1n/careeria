Ref password_reset_challenges_identity_fk: public.password_reset_challenges.identity_id > public.identities.id [delete: cascade]

Ref oauth_clients_created_by_fk: public.oauth_clients.created_by_identity_id > public.identities.id [delete: set null]
Ref oauth_client_redirect_uris_client_fk: public.oauth_client_redirect_uris.oauth_client_id > public.oauth_clients.id [delete: cascade]
Ref oauth_client_post_logout_redirect_uris_client_fk: public.oauth_client_post_logout_redirect_uris.oauth_client_id > public.oauth_clients.id [delete: cascade]
Ref oauth_client_grant_types_client_fk: public.oauth_client_grant_types.oauth_client_id > public.oauth_clients.id [delete: cascade]
Ref oauth_client_scopes_client_fk: public.oauth_client_scopes.oauth_client_id > public.oauth_clients.id [delete: cascade]
Ref oauth_client_credentials_client_fk: public.oauth_client_credentials.(oauth_client_id, client_type) > public.oauth_clients.(id, client_type) [delete: cascade]
Ref oauth_client_credentials_created_by_fk: public.oauth_client_credentials.created_by_identity_id > public.identities.id [delete: set null]
Ref oauth_authorization_grants_identity_fk: public.oauth_authorization_grants.identity_id > public.identities.id [delete: cascade]
Ref oauth_authorization_grants_client_fk: public.oauth_authorization_grants.oauth_client_id > public.oauth_clients.id [delete: cascade]
Ref oauth_authorization_grant_scopes_grant_fk: public.oauth_authorization_grant_scopes.grant_id > public.oauth_authorization_grants.id [delete: cascade]

Ref sessions_identity_fk: public.sessions.identity_id > public.identities.id [delete: cascade]
Ref sessions_oauth_client_fk: public.sessions.oauth_client_id > public.oauth_clients.id [delete: restrict]
Ref session_scopes_session_fk: public.session_scopes.session_id > public.sessions.id [delete: cascade]
Ref refresh_token_families_session_fk: public.refresh_token_families.session_id - public.sessions.id [delete: cascade]
Ref refresh_tokens_family_fk: public.refresh_tokens.family_id > public.refresh_token_families.id [delete: cascade]
Ref refresh_tokens_parent_fk: public.refresh_tokens.(parent_token_id, family_id) > public.refresh_tokens.(id, family_id)

Ref service_accounts_created_by_fk: public.service_accounts.created_by_identity_id > public.identities.id [delete: set null]
